local function deepCopy(v)
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, val in pairs(v) do
		out[k] = deepCopy(val)
	end
	return out
end

local function deepMerge(base, extra)
	local out = deepCopy(base)
	if type(extra) ~= "table" then
		return out
	end
	for k, v in pairs(extra) do
		if type(v) == "table" and type(out[k]) == "table" then
			out[k] = deepMerge(out[k], v)
		else
			out[k] = v
		end
	end
	return out
end

local CONFIG_FILE = "SC4Hub_Config.json"

local function encodeValue(v)
	local t = typeof(v)
	if t == "Color3" then
		return { __type = "Color3", r = v.R, g = v.G, b = v.B }
	elseif t == "EnumItem" then
		return { __type = "EnumItem", enum = tostring(v.EnumType), name = v.Name }
	elseif t == "Vector3" then
		return { __type = "Vector3", x = v.X, y = v.Y, z = v.Z }
	elseif t == "table" then
		local out = {}
		for k, val in pairs(v) do
			out[k] = encodeValue(val)
		end
		return out
	end
	return v
end

local function decodeValue(v)
	if type(v) == "table" then
		if v.__type == "Color3" then
			return Color3.new(v.r or 1, v.g or 1, v.b or 1)
		elseif v.__type == "EnumItem" then
			local enumName = tostring(v.enum or ""):gsub("^Enum%.", "")
			local ok, enum = pcall(function()
				return Enum[enumName]
			end)
			if ok and enum and enum[v.name] then
				return enum[v.name]
			end
			return nil
		elseif v.__type == "Vector3" then
			return Vector3.new(v.x or 0, v.y or 0, v.z or 0)
		end
		local out = {}
		for k, val in pairs(v) do
			out[k] = decodeValue(val)
		end
		return out
	end
	return v
end

local function loadConfig()
	if not isfile or not readfile then
		return nil
	end
	local ok, raw = pcall(readfile, CONFIG_FILE)
	if not ok or type(raw) ~= "string" or raw == "" then
		return nil
	end
	local ok2, decoded = pcall(function()
		return game:GetService("HttpService"):JSONDecode(raw)
	end)
	if not ok2 or type(decoded) ~= "table" then
		return nil
	end
	return decodeValue(decoded)
end

