	features.testExplosion = function()
		local mod = ReplicatedStorage:FindFirstChild("ExplosionMaker")
		if not mod or not mod:IsA("ModuleScript") then
			notify("Efekt", "ReplicatedStorage.ExplosionMaker bulunamadı.", 3, theme.warn)
			return
		end
		local ok, expMod = pcall(require, mod)
		if not ok or type(expMod) ~= "table" then
			notify("Efekt", "ExplosionMaker yüklenemedi.", 3, theme.bad)
			return
		end
		local pos = hrp and (hrp.Position + hrp.CFrame.LookVector * 18) or workspace.CurrentCamera.CFrame.Position + workspace.CurrentCamera.CFrame.LookVector * 20
		local triggered = false
		for _, fnName in ipairs({ "MakeExplosion", "CreateExplosion", "Explode", "PlayExplosion" }) do
			if type(expMod[fnName]) == "function" then
				local okCall = pcall(function()
					expMod[fnName](pos, 15, "GENERIC")
				end)
				if okCall then
					triggered = true
					break
				end
			end
		end
		if triggered then
			notify("Efekt", "Client patlama efekti oynatıldı!", 2, theme.good)
		else
			local e = Instance.new("Explosion")
			e.BlastPressure = 0
			e.BlastRadius = 0
			e.DestroyJointRadiusPercent = 0
			e.Position = pos
			e.Parent = workspace
			notify("Efekt", "Görsel patlama efekti oynatıldı.", 2, theme.accent)
		end
