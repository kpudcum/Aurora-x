	local function toggleFavorite(name)
		if state.favoriteSet[name] then
			for index, value in ipairs(state.favorites) do
				if value == name then
					table.remove(state.favorites, index)
					break
				end
			end
		else
			table.insert(state.favorites, name)
		end
		rebuildSets()
		safeFire("UpdateFavorites", state.favorites)
		notify("Favori", name .. (state.favoriteSet[name] and " eklendi." or " çıkarıldı."), 2, theme.accent)
		if refreshToys then
			refreshToys()
		end
	end

	local function spawnToy(name)
		if os.clock() - state.lastToySpawn < 0.7 then
			notify("Spawn", "Çok hızlı; biraz bekle.", 2, theme.warn)
			return
		end
		local canSpawn = playerValues.CanSpawnToy
		if canSpawn and canSpawn:IsA("BoolValue") and canSpawn.Value == false then
			notify("Spawn", "Şu an spawn kapalı (plot / limit).", 3, theme.warn)
			return
		end
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local rotate = workspace:FindFirstChild("RotateOrientPart")
		local orientation = rotate and rotate.Orientation or Vector3.new(0, 0, 0)
		state.lastToySpawn = os.clock()
		local ok, result = safeInvoke("SpawnToyRemoteFunction", name, cam.CFrame, orientation)
		if ok then
			notify("Spawn", name .. " istendi.", 2, theme.good)
			addLog("SpawnToy: " .. name, theme.good)
		else
			notify("Spawn", "İstek başarısız: " .. tostring(result), 3, theme.bad)
		end
	end

	local function buyToy(name)
		if os.clock() - state.lastBuy < 0.7 then
			notify("Satın Al", "Çok hızlı; biraz bekle.", 2, theme.warn)
			return
		end
		state.lastBuy = os.clock()
		local ok, result = safeInvoke("BuyToyRemoteFunction", name)
		if not ok then
			notify("Satın Al", "İstek başarısız.", 3, theme.bad)
			return
		end
		if result == "BoughtToy" then
			notify("Satın Al", name .. " satın alındı.", 3, theme.good)
			addLog("BuyToy: " .. name, theme.good)
			task.delay(1, requestProfile)
		elseif result == "GetCoins" then
			notify("Satın Al", "Yetersiz coin.", 3, theme.warn)
		else
			notify("Satın Al", "Sunucu yanıtı: " .. tostring(result), 3, theme.warn)
		end
	end

