	-- ---------------- WAYPOINT ----------------

	local waypointBase = setmetatable({}, { __mode = "k" })

	local function isOwnWaypoint(child, bg)
		if child and child.Name == LocalPlayer.Name then
			return true
		end
		local char = LocalPlayer.Character
		if char then
			local weld = child and child:FindFirstChildOfClass("WeldConstraint")
			if weld then
				if weld.Part1 and (weld.Part1 == char or weld.Part1:IsDescendantOf(char)) then
					return true
				end
				if weld.Part0 and (weld.Part0 == char or weld.Part0:IsDescendantOf(char)) then
					return true
				end
			end
			local adornee = bg and bg.Adornee
			if adornee and (adornee == char or adornee:IsDescendantOf(char)) then
				return true
			end
			if child and (child == char or child:IsDescendantOf(char)) then
				return true
			end
			if child and child:IsA("BasePart") and child.Name == "CharacterWaypoint" and hrp and hrp.Parent then
				if (child.Position - hrp.Position).Magnitude < 4.5 then
					return true
				end
			end
		end
		local myIcon = LocalPlayer:FindFirstChild("PlayerIcon")
		if myIcon and bg then
			local img = bg:FindFirstChildWhichIsA("ImageLabel", true)
			if img and img.Image ~= "" then
				local okImg, myImg = pcall(function() return myIcon.Image end)
				if okImg and myImg and myImg ~= "" and img.Image == myImg then
					return true
				end
			end
		end
		return false
	end

	local function hideOwnWaypointNow()
		local wp = workspace:FindFirstChild("Waypoints")
		if not wp then
			return
		end
		for _, child in ipairs(wp:GetChildren()) do
			local bg = child:FindFirstChild("BillboardGui") or (child:IsA("BillboardGui") and child or nil)
			if bg and bg:IsA("BillboardGui") and isOwnWaypoint(child, bg) then
				bg.Enabled = false
				bg.Size = UDim2.new(0, 0, 0, 0)
				for _, d in ipairs(bg:GetDescendants()) do
					if d:IsA("GuiObject") then
						d.Visible = false
					end
				end
			end
		end
	end

	local function applyWaypoints()
		local wp = workspace:FindFirstChild("Waypoints")
		if not wp then
			return
		end
		local scale = math.clamp(tonumber(config.waypointScale) or 100, 25, 400) / 100
		for _, child in ipairs(wp:GetChildren()) do
			local bg = child:FindFirstChild("BillboardGui") or (child:IsA("BillboardGui") and child or nil)
			if bg and bg:IsA("BillboardGui") then
				if isOwnWaypoint(child, bg) then
					bg.Enabled = false
					bg.Size = UDim2.new(0, 0, 0, 0)
					for _, d in ipairs(bg:GetDescendants()) do
						if d:IsA("GuiObject") then
							d.Visible = false
						end
					end
				else
					if waypointBase[bg] == nil then
						waypointBase[bg] = bg.Size
					end
					local base = waypointBase[bg]
					if scale ~= 1 then
						bg.Size = UDim2.new(base.X.Scale, math.floor(base.X.Offset * scale), base.Y.Scale, math.floor(base.Y.Offset * scale))
					else
						bg.Size = base
					end
					bg.Enabled = not config.hideWaypoints
				end
			end
		end
	end
	features.applyWaypoints = applyWaypoints

	-- Kendi CharacterWaypoint'imiz AutoGraphicsChanger tarafından 0.1s'de bir açılmasın diye her karede temizle
	task.defer(hideOwnWaypointNow)
