local function notify(title, message, duration, color)
	if unloaded then
		return
	end
	state.notifyId = state.notifyId + 1
	local card = create("CanvasGroup", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.panel,
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		LayoutOrder = -state.notifyId,
	}, notifyHolder)
	corner(card, 8)
	stroke(card, color or theme.accent, 1)
	create("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = color or theme.accent,
		BorderSizePixel = 0,
	}, card)
	local body = create("Frame", {
		Size = UDim2.new(1, -18, 0, 0),
		Position = UDim2.new(0, 12, 0, 8),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, card)
	create("UIListLayout", { Padding = UDim.new(0, 2) }, body)
	create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = tostring(title),
		TextColor3 = theme.text,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, body)
	create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = tostring(message),
		TextColor3 = theme.subtext,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, body)
	table.insert(notifyCards, card)
	while #notifyCards > 5 do
		local old = table.remove(notifyCards, 1)
		if old then
			old:Destroy()
		end
	end
	tween(card, 0.22, { GroupTransparency = 0 })
	task.delay(duration or 4, function()
		if card and card.Parent then
			tween(card, 0.22, { GroupTransparency = 1 })
			task.wait(0.28)
			card:Destroy()
			for i, c in ipairs(notifyCards) do
				if c == card then
					table.remove(notifyCards, i)
					break
				end
			end
		end
	end)
	addLog(tostring(title) .. ": " .. tostring(message), color)
end

