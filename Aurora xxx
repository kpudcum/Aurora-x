local remoteCache = {}

local function resolveRemote(name)
	local cached = remoteCache[name]
	if cached and cached.Parent then
		return cached
	end
	local path = remotePaths[name]
	if not path then
		return nil
	end
	local node = ReplicatedStorage
	for _, part in ipairs(path) do
		if not node then
			return nil
		end
		node = node:FindFirstChild(part)
	end
	if node then
		remoteCache[name] = node
	end
	return node
end

local function safeFire(name, ...)
	local remote = resolveRemote(name)
	if remote and remote:IsA("RemoteEvent") then
		local args = { ... }
		local ok, err = pcall(function()
			remote:FireServer(table.unpack(args))
		end)
		if not ok then
			addLog("Remote hata (" .. name .. "): " .. tostring(err), theme.bad)
		end
		return ok
	end
	return false
end

local function safeInvoke(name, ...)
	local remote = resolveRemote(name)
	if remote and remote:IsA("RemoteFunction") then
		local args = { ... }
		local ok, result = pcall(function()
			return remote:InvokeServer(table.unpack(args))
		end)
		if ok then
			return true, result
		end
		addLog("Invoke hata (" .. name .. "): " .. tostring(result), theme.bad)
		return false, result
	end
	return false, nil
end

local function safeBindable(name, ...)
	local remote = resolveRemote(name)
	if remote and remote:IsA("BindableEvent") then
		local args = { ... }
		local ok = pcall(function()
			remote:Fire(table.unpack(args))
		end)
		return ok
	end
	return false
end

