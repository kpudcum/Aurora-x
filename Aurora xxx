			if state.grabbedClone then
				applyBeamToClone(state.grabbedClone, color)
			end
			if state.customGrab.clone then
				applyBeamToClone(state.customGrab.clone, color)
			end
		else
			local preset = beamPresets[config.beamPreset]
			if typeof(preset) == "Color3" then
				if state.grabbedClone then
					applyBeamToClone(state.grabbedClone, preset)
