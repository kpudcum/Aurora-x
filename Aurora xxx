			local center = startCenter + Vector2.new(delta.X, delta.Y)
			center = Vector2.new(
				math.clamp(center.X, size.X / 2, math.max(size.X / 2, viewport.X - size.X / 2)),
				math.clamp(center.Y, size.Y / 2, math.max(size.Y / 2, viewport.Y - size.Y / 2))
			)
			mainFrame.Position = UDim2.fromOffset(center.X, center.Y)
		end
	end)
