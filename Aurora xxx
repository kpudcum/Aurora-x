local function getCustomGrabTemplate()
	local template = ReplicatedFirst:FindFirstChild("GrabParts")
	if not template then
		template = ReplicatedFirst:WaitForChild("GrabParts", 5)
	end
	return template
end

local customGrabRelease

local function customGrabStart()
	if unloaded then
		return
	end
	if not config.customGrab then
		notify("SC4 Grab", "Önce Grab sekmesinden SC4 Grab'i aç.", 3, theme.warn)
		return
	end
	if state.customGrab.active then
		customGrabRelease(false)
	end
	if not character or not humanoid or humanoid.Health <= 0 then
		notify("SC4 Grab", "Karakter hazır değil.", 3, theme.warn)
		return
	end
	local range = math.clamp(tonumber(config.customGrabRange) or 80, 3, 300)
	local hit, offset
	local rayMod = getRaycastModule()
	if rayMod then
		local ok, h, o = pcall(function()
			return rayMod.RaycastFromCam(LocalPlayer, range)
		end)
		if ok then
			hit = h
			offset = o
		end
	end
	if not hit then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		params.IgnoreWater = true
		hit = workspace:Raycast(workspace.CurrentCamera.CFrame.Position, workspace.CurrentCamera.CFrame.LookVector * range, params)
		if hit then
			offset = hit.Instance.CFrame:ToObjectSpace(CFrame.new(hit.Position))
		end
	end
	if not hit then
		notify("SC4 Grab", "Menzilde uygun parça yok.", 3, theme.warn)
		return
	end
	local part = hit.Instance
	if not part or not part:IsA("BasePart") then
		notify("SC4 Grab", "Hedef bir parça değil.", 3, theme.warn)
		return
	end
	if part.Anchored then
		notify("SC4 Grab", "Parça sabit (anchored).", 3, theme.warn)
		return
	end
	local template = getCustomGrabTemplate()
	if not template or not template:IsA("Model") then
		notify("SC4 Grab", "ReplicatedFirst.GrabParts bulunamadı.", 4, theme.bad)
		return
	end
	local clone = template:Clone()
	clone.Name = "SC4GrabParts"
	local grabPart = clone:FindFirstChild("GrabPart")
	local dragPart = clone:FindFirstChild("DragPart")
	local beamPart = clone:FindFirstChild("BeamPart")
	local weld = grabPart and grabPart:FindFirstChild("WeldConstraint")
	local grabAttach = grabPart and grabPart:FindFirstChild("GrabAttach")
	local dragAttach = dragPart and dragPart:FindFirstChild("DragAttach")
	local beam = beamPart and beamPart:FindFirstChild("GrabBeam")
	if not (grabPart and dragPart and beamPart and weld and beam) then
		clone:Destroy()
		notify("SC4 Grab", "GrabParts şablonu eksik/uyumsuz.", 4, theme.bad)
		return
	end
	local cam = workspace.CurrentCamera
	local distance = math.clamp(tonumber(config.customGrabDistance) or 28, 3, 150)
	local hitPos = hit.Position
	local targetPos = cam.CFrame.Position + cam.CFrame.LookVector * distance
	if not offset then
		offset = part.CFrame:ToObjectSpace(CFrame.new(hitPos))
	end
	dragPart.Anchored = true
	dragPart.Position = targetPos
	grabPart.Anchored = false
	beamPart.Anchored = true
	weld.Part0 = grabPart
	weld.Part1 = part
	grabPart.Position = hitPos
	beamPart.Position = hitPos
	if grabAttach then
		grabAttach.CFrame = CFrame.new(grabAttach.Position) * cam.CFrame.Rotation
	end
	if dragAttach then
		dragAttach.WorldCFrame = CFrame.new(targetPos) * cam.CFrame.Rotation
	end
	local camAtt = getCameraAttachment()
	if camAtt and beam then
		beam.Attachment0 = camAtt
	end
	clone.Parent = workspace
	state.customGrab.active = true
	state.customGrab.part = part
	state.customGrab.clone = clone
	state.customGrab.distance = distance
	state.customGrab.yaw = 0
	state.customGrab.pitch = 0
	state.customGrab.rotating = false
	safeFire("CreateGrabLine", part, offset)
	safeFire("ExtendGrabLine", math.floor(distance))
	safeFire("SetNetworkOwner", part, cam.CFrame)
	local preset = beamPresets[config.beamPreset]
	if typeof(preset) == "Color3" then
		applyBeamToClone(clone, preset)
	elseif config.rainbowBeam then
		applyBeamToClone(clone, Color3.fromHSV((os.clock() * 0.15) % 1, 1, 1))
	end
	addLog("SC4 Grab: " .. part.Name .. " • " .. tostring(math.floor(distance)) .. " stud", theme.accent)
	notify("SC4 Grab", part.Name .. " tutuldu. T = fırlat, Y = bırak, R = döndür.", 4, theme.accent)
end

customGrabRelease = function(throwIt)
	local cg = state.customGrab
	if not cg.active then
		return
	end
	local part = cg.part
	local clone = cg.clone
	cg.active = false
	cg.part = nil
	cg.clone = nil
	cg.rotating = false
	if clone then
		clone:Destroy()
	end
	if part and part:IsDescendantOf(workspace) then
		safeFire("DestroyGrabLine", part)
		if throwIt then
			applyThrowToPart(part)
		end
	end
	notify("SC4 Grab", throwIt and "Fırlatıldı." or "Bırakıldı.", 2.5, theme.accent)
end

connect(RunService.RenderStepped, function()
	local cg = state.customGrab
	if not cg.active then
		return
	end
	local part = cg.part
	local clone = cg.clone
	if not part or not part:IsDescendantOf(workspace) or not clone or not clone.Parent then
		customGrabRelease(false)
		return
	end
	local cam = workspace.CurrentCamera
	local dragPart = clone:FindFirstChild("DragPart")
	local grabPart = clone:FindFirstChild("GrabPart")
	local beamPart = clone:FindFirstChild("BeamPart")
	local dragAttach = dragPart and dragPart:FindFirstChild("DragAttach")
	local beam = beamPart and beamPart:FindFirstChild("GrabBeam")
	if not (dragPart and grabPart and beamPart and beam) then
		customGrabRelease(false)
		return
	end
	local targetPos = cam.CFrame.Position + cam.CFrame.LookVector * cg.distance
	dragPart.Position = targetPos
	if dragAttach then
		dragAttach.WorldCFrame = CFrame.new(targetPos) * CFrame.Angles(cg.pitch, cg.yaw, 0)
	end
	if (grabPart.Position - targetPos).Magnitude > 0.05 then
		local dir = (targetPos - grabPart.Position).Unit
		local upVec = math.abs(dir:Dot(Vector3.yAxis)) > 0.98 and Vector3.xAxis or Vector3.yAxis
		beamPart.CFrame = CFrame.lookAt(grabPart.Position, targetPos, upVec)
	end
	beam.CurveSize1 = (grabPart.Position - targetPos).Magnitude * 1.5
	local camAtt = getCameraAttachment()
	if camAtt and beam.Attachment0 ~= camAtt then
		beam.Attachment0 = camAtt
	end
end)

connect(UserInputService.InputChanged, function(input)
	if unloaded or not state.customGrab.active or not state.customGrab.rotating then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		local sens = (tonumber(config.rotateSensitivity) or 2) * 0.01
		state.customGrab.yaw = state.customGrab.yaw + input.Delta.X * sens
		state.customGrab.pitch = math.clamp(state.customGrab.pitch + input.Delta.Y * sens, -math.pi / 2, math.pi / 2)
	end
end)

connect(UserInputService.InputBegan, function(input, gameProcessed)
	if unloaded or gameProcessed then
		return
	end
	if UserInputService:GetFocusedTextBox() then
		return
	end
	if input.KeyCode == Enum.KeyCode.G and config.customGrab then
		if state.customGrab.active then
			customGrabRelease(false)
		else
			customGrabStart()
		end
	elseif input.KeyCode == Enum.KeyCode.T and config.customGrab and state.customGrab.active then
		customGrabRelease(true)
	elseif input.KeyCode == Enum.KeyCode.Y and config.customGrab and state.customGrab.active then
		customGrabRelease(false)
	elseif input.KeyCode == Enum.KeyCode.R and config.customGrab and state.customGrab.active then
		state.customGrab.rotating = not state.customGrab.rotating
		notify("SC4 Grab", state.customGrab.rotating and "Döndürme modu açık (fare)." or "Döndürme modu kapalı.", 2, theme.accent)
	end
end)

task.spawn(function()
