local function tween(inst, duration, props, style, direction)
	local t = TweenService:Create(
		inst,
		TweenInfo.new(duration or 0.2, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function addLog(message, color)
	message = tostring(message)
	table.insert(state.log, 1, {
		text = os.date("%H:%M:%S") .. "  " .. message,
		color = color or theme.subtext,
	})
	while #state.log > 40 do
		table.remove(state.log)
	end
	if uiRefs.logContainer then
		for _, child in ipairs(uiRefs.logContainer:GetChildren()) do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		for i = 1, math.min(#state.log, 10) do
			local entry = state.log[i]
			create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				Text = entry.text,
				TextColor3 = entry.color,
				Font = Enum.Font.Code,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				LayoutOrder = i,
			}, uiRefs.logContainer)
		end
	end
	if config and config.debug then
		print("[SC4Hub] " .. message)
	end
end

