	-- ---------------- HOVER / FREEZE GRAB & OYUNCAK YÖRÜNGESİ ----------------

	local hoveredParts = {}

	local function unhoverPart(part)
		local entry = hoveredParts[part]
		if not entry then
			return
		end
		if entry.bp and entry.bp.Parent then
			entry.bp:Destroy()
		end
		if entry.bg and entry.bg.Parent then
			entry.bg:Destroy()
		end
		hoveredParts[part] = nil
	end

	local function hoverPart(part)
		if not part or not part:IsA("BasePart") or part.Anchored or not part:IsDescendantOf(workspace) then
			return
		end
		if hoveredParts[part] then
			hoveredParts[part].pos = part.Position
			hoveredParts[part].cf = part.CFrame
			if hoveredParts[part].bp then
				hoveredParts[part].bp.Position = part.Position
			end
			if hoveredParts[part].bg then
				hoveredParts[part].bg.CFrame = part.CFrame
			end
			return
		end
		local bp = Instance.new("BodyPosition")
		bp.Name = "SC4HoverPos"
		bp.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		bp.P = 25000
		bp.D = 1200
		bp.Position = part.Position
		bp.Parent = part

		local bg = Instance.new("BodyGyro")
		bg.Name = "SC4HoverGyro"
		bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
		bg.P = 15000
		bg.D = 800
		bg.CFrame = part.CFrame
		bg.Parent = part

		hoveredParts[part] = { bp = bp, bg = bg, pos = part.Position, cf = part.CFrame }
		addLog("Havada sabitlendi: " .. part.Name, theme.accent)
	end

	features.releaseAllHovered = function(silent)
		local n = 0
		for part in pairs(hoveredParts) do
			unhoverPart(part)
			n = n + 1
		end
		if not silent then
			notify("Hover Grab", tostring(n) .. " sabitlenmiş parça bırakıldı.", 2.5, theme.accent)
		end
	end

	local lastTrackedGrabPart = nil
	connect(workspace.ChildRemoved, function(child)
		if unloaded then
			return
		end
		if child.Name == "GrabParts" and config.hoverGrab then
			local target = state.grabbedPart or lastTrackedGrabPart
