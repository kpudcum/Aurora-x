local function applyBeamValues(color)
	local bc = playerValues.BeamColor or LocalPlayer:FindFirstChild("BeamColor")
	if not bc then
		return
	end
	local seq = bc:FindFirstChild("ColorSequenceHolder")
	local ball = bc:FindFirstChild("BallColorHolder")
	if seq then
		pcall(function()
			seq.Value = ColorSequence.new(color)
		end)
	end
	if ball then
		pcall(function()
			ball.Value = color
		end)
	end
end

local function applyBeamToClone(clone, color)
	if not clone or not clone.Parent then
		return
	end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("Beam") then
			d.Color = ColorSequence.new(color)
		elseif d:IsA("BasePart") then
			d.Color = color
		end
	end
end

