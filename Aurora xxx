			end
		end
	end)

	connect(RunService.Heartbeat, function()
		if unloaded then
			return
		end
		if state.grabbedPart then
			lastTrackedGrabPart = state.grabbedPart
		end
		for part, entry in pairs(hoveredParts) do
			if not part or not part.Parent or not part:IsDescendantOf(workspace) then
				unhoverPart(part)
			elseif not config.hoverGrab then
				unhoverPart(part)
			else
				if entry.bp then
					entry.bp.Position = entry.pos
				end
				if entry.bg then
					entry.bg.CFrame = entry.cf
				end
			end
		end

		if config.orbitToys and hrp and hrp.Parent then
			local toys = getMySpawnedToys()
			local count = #toys
			if count > 0 then
				local radius = math.clamp(tonumber(config.orbitRadius) or 12, 4, 45)
				local speed = math.clamp(tonumber(config.orbitSpeed) or 2.5, 0.2, 12)
				local t = os.clock() * speed
				local center = hrp.Position + Vector3.new(0, 2, 0)
				for i, toy in ipairs(toys) do
					local angle = t + ((i - 1) / count) * (math.pi * 2)
					local targetPos = center + Vector3.new(math.cos(angle) * radius, math.sin(angle * 2) * 1.5, math.sin(angle) * radius)
					local primary = toy.PrimaryPart or toy:FindFirstChildWhichIsA("BasePart")
					if primary and not primary.Anchored then
						local diff = targetPos - primary.Position
						primary.AssemblyLinearVelocity = diff * 10
						primary.AssemblyAngularVelocity = Vector3.new(0, speed * 2, 0)
					end
				end
			end
		end

		-- ---- SPAWN EDİNCE OTOMATİK DÖNDÜR (ETRAFIMDA YÖRÜNGE + BODYMOVER + KENDİ EKSENİNDE DÖNME) ----
		local spawnedToysNow = getMySpawnedToys()
		if config.autoSpinSpawned then
			local count = #spawnedToysNow
			if count > 0 then
				local spinSpd = math.clamp(tonumber(config.autoSpinSpeed) or 25, 2, 150)
				local aroundMe = config.autoSpinAroundMe ~= false
				local radius = math.clamp(tonumber(config.autoSpinRadius) or 12, 4, 50)
				local height = math.clamp(tonumber(config.autoSpinHeight) or 2, -5, 25)
				local orbSpeed = math.clamp(tonumber(config.autoSpinOrbitSpeed) or 3, 0.2, 15)
				local t = os.clock() * orbSpeed
				local center = (hrp and hrp.Parent) and (hrp.Position + Vector3.new(0, height, 0)) or nil

				for i, toy in ipairs(spawnedToysNow) do
					local primary = toy.PrimaryPart or toy:FindFirstChildWhichIsA("BasePart")
					if primary and not primary.Anchored then
						local bav = primary:FindFirstChild("SC4OrbitBAV")
						if not bav then
							bav = Instance.new("BodyAngularVelocity")
							bav.Name = "SC4OrbitBAV"
							bav.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
							bav.P = 15000
							bav.Parent = primary
						end
						bav.AngularVelocity = Vector3.new(spinSpd * 0.35, spinSpd, spinSpd * 0.25)

						if aroundMe and center then
							local angle = t + ((i - 1) / count) * (math.pi * 2)
							local floatY = config.autoSpinFloat and (math.sin(os.clock() * 4 + i) * 2.5) or 0
							local targetPos = center + Vector3.new(math.cos(angle) * radius, floatY, math.sin(angle) * radius)
							local bp = primary:FindFirstChild("SC4OrbitBP")
							if not bp then
								bp = Instance.new("BodyPosition")
								bp.Name = "SC4OrbitBP"
								bp.MaxForce = Vector3.new(1e6, 1e6, 1e6)
								bp.P = 20000
								bp.D = 900
								bp.Parent = primary
							end
							bp.Position = targetPos
						else
							local oldBP = primary:FindFirstChild("SC4OrbitBP")
							if oldBP then oldBP:Destroy() end
							if config.autoSpinFloat then
								local vy = math.sin(os.clock() * 4 + i) * 3
								primary.AssemblyLinearVelocity = Vector3.new(primary.AssemblyLinearVelocity.X * 0.9, vy, primary.AssemblyLinearVelocity.Z * 0.9)
							end
						end
					end
				end
			end
		else
			for _, toy in ipairs(spawnedToysNow) do
				local primary = toy.PrimaryPart or toy:FindFirstChildWhichIsA("BasePart")
				if primary then
					local bp = primary:FindFirstChild("SC4OrbitBP")
					if bp then bp:Destroy() end
					local bav = primary:FindFirstChild("SC4OrbitBAV")
					if bav then bav:Destroy() end
				end
			end
		end

		-- ---- KARA DELİK (TOY BLACK HOLE) & KALKAN (TOY SHIELD) ----
		if (config.toyBlackHole or config.toyShield) and hrp and hrp.Parent then
			local toys = getMySpawnedToys()
			local count = #toys
			if count > 0 then
				local cam = workspace.CurrentCamera
				local t = os.clock()
				if config.toyBlackHole and cam then
					local holeCenter = cam.CFrame.Position + cam.CFrame.LookVector * 20
					for i, toy in ipairs(toys) do
						local primary = toy.PrimaryPart or toy:FindFirstChildWhichIsA("BasePart")
						if primary and not primary.Anchored then
							local a = t * 6 + ((i - 1) / count) * (math.pi * 2)
							local spiralR = 2.5 + math.sin(t * 4 + i) * 1.5
							local targetPos = holeCenter + Vector3.new(math.cos(a) * spiralR, math.sin(a * 1.7) * spiralR, math.sin(a) * spiralR)
							primary.AssemblyLinearVelocity = (targetPos - primary.Position) * 14
							primary.AssemblyAngularVelocity = Vector3.new(40, 60, 40)
						end
					end
				elseif config.toyShield then
					local center = hrp.Position + Vector3.new(0, 1.5, 0)
					for i, toy in ipairs(toys) do
						local primary = toy.PrimaryPart or toy:FindFirstChildWhichIsA("BasePart")
						if primary and not primary.Anchored then
							local a = t * 3.5 + ((i - 1) / count) * (math.pi * 2)
							local targetPos = center + Vector3.new(math.cos(a) * 6.5, (i % 2 == 0 and 1.2 or -0.5), math.sin(a) * 6.5)
							primary.AssemblyLinearVelocity = (targetPos - primary.Position) * 16
							primary.AssemblyAngularVelocity = Vector3.new(0, 12, 0)
						end
					end
				end
			end
		end

		-- ---- GRAB ANİMASYONLARI (TOP OYNATMA / TORNADO / SARKAÇ / PERVANE / SEKİZ) ----
		if config.grabAnimEnabled then
			local gPart = (state.customGrab and state.customGrab.active and state.customGrab.part) or state.grabbedPart
			local gClone = (state.customGrab and state.customGrab.active and state.customGrab.clone) or state.grabbedClone
			if gPart and gPart:IsDescendantOf(workspace) and not gPart.Anchored and hrp and hrp.Parent then
				local cam = workspace.CurrentCamera
				local t = os.clock() * math.clamp(tonumber(config.grabAnimSpeed) or 4, 0.5, 20)
				local rad = math.clamp(tonumber(config.grabAnimRadius) or 8, 3, 30)
				local mode = config.grabAnimMode or "Top Sektirme"
				local basePos = cam and (cam.CFrame.Position + cam.CFrame.LookVector * math.max(10, rad + 4)) or (hrp.Position + hrp.CFrame.LookVector * 12)
				local rightVec = cam and cam.CFrame.RightVector or hrp.CFrame.RightVector
				local upVec = Vector3.yAxis
				local targetPos = basePos
				local spinVec = Vector3.new(15, 35, 15)

				if mode == "Top Sektirme" then
					local bounce = math.abs(math.sin(t * 1.4)) * rad
					local side = math.cos(t * 0.9) * (rad * 0.55)
					targetPos = basePos + rightVec * side + upVec * (bounce - rad * 0.35)
					spinVec = Vector3.new(25, 45, 25)
				elseif mode == "Sağa-Sola Sarkaç" then
					local swing = math.sin(t * 1.5) * (rad * 1.35)
					local dip = -math.abs(math.cos(t * 1.5)) * (rad * 0.35)
					targetPos = basePos + rightVec * swing + upVec * dip
					spinVec = Vector3.new(0, math.cos(t * 1.5) * 40, math.sin(t * 1.5) * 35)
				elseif mode == "Tornado / Girdap" then
					local r = rad * 0.85
					targetPos = hrp.Position + Vector3.new(math.cos(t * 2) * r, 3 + math.sin(t * 1.2) * 4, math.sin(t * 2) * r)
					spinVec = Vector3.new(40, 90, 40)
				elseif mode == "Baş Üstü Pervane" then
					targetPos = hrp.Position + Vector3.new(math.cos(t * 2.2) * (rad * 0.7), 9, math.sin(t * 2.2) * (rad * 0.7))
					spinVec = Vector3.new(0, 110, 0)
				elseif mode == "Sekiz Çizme (∞)" then
					local x = math.sin(t) * (rad * 1.2)
					local y = math.sin(t * 2) * (rad * 0.55)
					targetPos = basePos + rightVec * x + upVec * y
					spinVec = Vector3.new(20, 30, 20)
				end

				local dragPart = gClone and gClone:FindFirstChild("DragPart")
				if dragPart and dragPart:IsA("BasePart") then
					dragPart.Position = targetPos
				end
				local diff = targetPos - gPart.Position
				local parts = getAssemblyParts(gPart)
				for _, p in ipairs(parts) do
					if p:IsA("BasePart") and not p.Anchored then
						p.AssemblyLinearVelocity = diff * 12
						p.AssemblyAngularVelocity = spinVec
					end
				end
			end
		end
	end)

