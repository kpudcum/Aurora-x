	local function unloadHub()
		if unloaded then
			return
		end
		unloaded = true
		if state.customGrab.active then
			pcall(customGrabRelease, false)
		end
		pcall(function()
			setFly(false)
		end)
		pcall(function()
			setNoclip(false)
		end)
		pcall(function()
			features.setFreecam(false)
		end)
		pcall(function()
			features.setESP(false)
		end)
		pcall(function()
			features.setLowQuality(false)
		end)
		pcall(function()
			features.setFullbright(false)
		end)
		pcall(function()
			features.setHideOtherBeams(false)
		end)
		pcall(function()
			features.setHideWaypoints(false)
			if features.releaseAllHovered then
				features.releaseAllHovered(true)
			end
		end)
		saveConfigNow()
		for _, connection in ipairs(connections) do
			pcall(function()
				connection:Disconnect()
			end)
		end
		connections = {}
		if mainGui then
			mainGui:Destroy()
		end
		if notifyGui then
			notifyGui:Destroy()
		end
		if crosshairGui then
			crosshairGui:Destroy()
		end
		if hudGui then
			hudGui:Destroy()
		end
		local esp = workspace:FindFirstChild("SC4ESP")
		if esp then
			esp:Destroy()
		end
		local custom = workspace:FindFirstChild("SC4GrabParts")
		if custom then
			custom:Destroy()
		end
		_G.SC4HubUnload = nil
		print("[SC4Hub] Kapatıldı.")
	end
	_G.SC4HubUnload = unloadHub

