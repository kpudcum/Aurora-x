local function getAssemblyParts(part)
	local parts = {}
	if part and part.Parent and part.Parent:IsA("Model") and part.Parent ~= workspace then
		for _, child in ipairs(part.Parent:GetDescendants()) do
			if child:IsA("BasePart") then
				table.insert(parts, child)
			end
		end
	end
	if #parts == 0 and part then
		parts = { part }
	end
	return parts
end

local function refreshGrabState()
	local clone = workspace:FindFirstChild("GrabParts")
	if clone and clone:IsA("Model") then
		local grabPart = clone:FindFirstChild("GrabPart")
		local dragPart = clone:FindFirstChild("DragPart")
		local weld = grabPart and grabPart:FindFirstChild("WeldConstraint")
		local part = weld and weld.Part1
		if part and part:IsA("BasePart") and part:IsDescendantOf(workspace) then
			state.grabbedPart = part
			state.grabbedModel = (part.Parent ~= workspace and part.Parent:IsA("Model")) and part.Parent or nil
			state.grabbedClone = clone
			state.grabbedLastSeen = os.clock()
			local camPos = workspace.CurrentCamera.CFrame.Position
			state.grabbedDistance = dragPart and (dragPart.Position - camPos).Magnitude or 0
			local mass = 0
			for _, p in ipairs(getAssemblyParts(part)) do
				mass = mass + (p.Mass or 0)
			end
			state.grabbedMass = mass
			return
		end
	end
	if state.grabbedPart and (os.clock() - state.grabbedLastSeen > 0.6) then
		state.grabbedPart = nil
		state.grabbedModel = nil
		state.grabbedClone = nil
		state.grabbedMass = 0
		state.grabbedDistance = 0
	end
end
connect(RunService.Heartbeat, refreshGrabState)

local function getSpinAxis()
	local axis = config.spinAxis
	if axis == "X" then
		return Vector3.new(1, 0, 0)
	elseif axis == "Y" then
		return Vector3.new(0, 1, 0)
	elseif axis == "Z" then
		return Vector3.new(0, 0, 1)
	end
	return Vector3.new(0.577, 0.577, 0.577)
end

local function applyThrowToPart(part)
	if not part or not part:IsDescendantOf(workspace) then
		notify("Fırlatma", "Tutulan parça bulunamadı.", 3, theme.warn)
		return
	end
	if part.Anchored then
		notify("Fırlatma", "Parça sabit (anchored), fırlatılamaz.", 3, theme.warn)
		return
	end
	local cam = workspace.CurrentCamera
	local dir = cam.CFrame.LookVector
	if config.throwDirection == "Yukarı" then
		dir = (dir + Vector3.new(0, 1, 0)).Unit
	elseif config.throwDirection == "Karakter" and hrp then
		dir = hrp.CFrame.LookVector
	end
	local speed = math.clamp(100 * (tonumber(config.throwMultiplier) or 1), 50, tonumber(config.throwMaxSpeed) or 1800)
	local velocity = dir * speed + Vector3.new(0, tonumber(config.throwUpBoost) or 0, 0)
	local angular = getSpinAxis() * (tonumber(config.spinSpeed) or 0)
	local parts = getAssemblyParts(part)
	state.throwToken = state.throwToken + 1
	local token = state.throwToken
	for _, p in ipairs(parts) do
		if p:IsA("BasePart") and not p.Anchored then
			p.AssemblyLinearVelocity = velocity
			if config.spinOnThrow then
				p.AssemblyAngularVelocity = angular
			end
		end
	end
	task.spawn(function()
		local endTime = os.clock() + 0.4
		while os.clock() < endTime and state.throwToken == token and not unloaded do
			if part:IsDescendantOf(workspace) then
				for _, p in ipairs(parts) do
					if p:IsA("BasePart") and not p.Anchored then
						p.AssemblyLinearVelocity = velocity
						if config.spinOnThrow then
							p.AssemblyAngularVelocity = angular
						end
					end
				end
			end
			RunService.Heartbeat:Wait()
		end
	end)
	addLog("Fırlatıldı: " .. part.Name .. " • " .. tostring(math.floor(speed)) .. " stud/s" .. (config.spinOnThrow and (" • spin " .. tostring(math.floor(config.spinSpeed))) or ""), theme.accent)
	notify("Süper Fırlat", part.Name .. " • " .. tostring(math.floor(speed)) .. " stud/s", 2.5, theme.accent)
end

connect(UserInputService.InputBegan, function(input)
	if unloaded then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		if config.superThrow and state.grabbedPart and not state.customGrab.active then
			if UserInputService:GetFocusedTextBox() then
				return
			end
			local part = state.grabbedPart
			task.defer(function()
				if part and part == state.grabbedPart then
					applyThrowToPart(part)
				end
			end)
		end
	end
end)

connect(RunService.Heartbeat, function()
	if unloaded or not config.spinHold or (tonumber(config.spinSpeed) or 0) <= 0 then
		return
	end
	local part = state.grabbedPart
	if not part or not part:IsDescendantOf(workspace) or part.Anchored then
		return
	end
	local target = getSpinAxis() * (tonumber(config.spinSpeed) or 0)
	for _, p in ipairs(getAssemblyParts(part)) do
		if p:IsA("BasePart") and not p.Anchored then
			p.AssemblyAngularVelocity = target
		end
	end
	local clone = state.grabbedClone
	if clone then
		local gp = clone:FindFirstChild("GrabPart")
		if gp and gp:IsA("BasePart") and not gp.Anchored then
			gp.AssemblyAngularVelocity = target
		end
	end
end)

