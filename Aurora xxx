	noteLabel(infoSection, "Bu hub tamamen istemci taraflıdır. Sunucunun doğruladığı işlemler (oyuncak sahipliği, para, gamepass, hasar, aşırı hız) sunucu tarafından reddedilebilir. Aşırı fırlatma ve spin değerleri fiziksel kaçmalara, parçaların haritadan çıkmasına veya karakterin ragdoll olmasına yol açabilir. Deneysel özellikleri kendi riskinle kullan.")

	-- ============================================================
	-- CANLI GÜNCELLEMELER
	-- ============================================================

	task.spawn(function()
		while not unloaded do
			statusLabel.Text = tostring(state.fps) .. " FPS  •  " .. tostring(math.floor(state.ping)) .. " ms"
			local playerText = tostring(#Players:GetPlayers()) .. " / " .. tostring(Players.MaxPlayers)
			if uiRefs.dashboard.players then
				uiRefs.dashboard.players.Text = playerText
			end
			if uiRefs.players.count then
				uiRefs.players.count.Text = playerText
			end
			task.wait(1)
		end
	end)

	local statTick = 0
	task.spawn(function()
		while not unloaded do
			if uiRefs.performance.fps then
				uiRefs.performance.fps.Text = tostring(state.fps) .. " FPS"
				uiRefs.performance.ping.Text = tostring(math.floor(state.ping)) .. " ms"
				uiRefs.performance.memory.Text = string.format("%.0f MB", state.memory)
				uiRefs.performance.players.Text = tostring(#Players:GetPlayers()) .. " / " .. tostring(Players.MaxPlayers)
				statTick = statTick + 1
				if statTick >= 10 then
					statTick = 0
					uiRefs.performance.parts.Text = tostring(#workspace:GetDescendants())
				end
			end
			task.wait(1)
		end
	end)

	task.spawn(function()
		while not unloaded do
			if uiRefs.grab and uiRefs.grab.part then
				local part = state.grabbedPart
				local distance = state.grabbedDistance
				local mass = state.grabbedMass
				if state.customGrab.active and state.customGrab.part then
					part = state.customGrab.part
					distance = state.customGrab.distance
					mass = 0
					for _, p in ipairs(getAssemblyParts(part)) do
						mass = mass + (p.Mass or 0)
					end
				end
				if part then
					uiRefs.grab.part.Text = part.Name
					uiRefs.grab.distance.Text = string.format("%.1f stud", distance or 0)
					uiRefs.grab.mass.Text = tostring(math.floor(mass)) .. " kg"
				else
					uiRefs.grab.part.Text = "-"
					uiRefs.grab.distance.Text = "-"
					uiRefs.grab.mass.Text = "-"
				end
				uiRefs.grab.custom.Text = state.customGrab.active and ("Aktif • " .. tostring(math.floor(state.customGrab.distance)) .. " stud") or "Kapalı"
				uiRefs.grab.beam.Text = tostring(config.beamPreset or "Varsayılan") .. (config.rainbowBeam and " • Rainbow" or "")
			end
			task.wait(0.5)
		end
	end)

	task.spawn(function()
		while not unloaded do
			if config.crosshair then
				if not crosshairGui.Enabled then
					crosshairGui.Enabled = true
				end
				local gameCross = PlayerGui:FindFirstChild("Crosshairs")
				if gameCross and gameCross:IsA("ScreenGui") and gameCross.Enabled then
					gameCross.Enabled = false
				end
			end
			task.wait(1)
		end
	end)

	-- ============================================================
	-- BAŞLAT
	-- ============================================================

	syncUI()
	updateDashboard()
	addLog("Arayüz hazır. RightShift ile paneli aç/kapat.", theme.good)
	notify("SC4 Hub", "Hazır. RightShift ile paneli aç. SC4 Grab: G / T / Y / R.", 5, theme.accent)
end)()
