		task.spawn(function()
			local nearest, bestDist = nil, math.huge
			if hrp then
				for _, plr in ipairs(Players:GetPlayers()) do
					if plr ~= LocalPlayer and plr.Character then
						local pHRP = plr.Character:FindFirstChild("HumanoidRootPart")
