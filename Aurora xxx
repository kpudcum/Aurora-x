	local function paintTabs()
		for name, btn in pairs(tabButtons) do
			local isActive = (name == activeTab)
			btn.BackgroundColor3 = isActive and theme.accent or theme.panel
			btn.BackgroundTransparency = isActive and 0.12 or 1
			btn.TextColor3 = isActive and Color3.fromRGB(255, 255, 255) or theme.subtext
			local activeBar = btn:FindFirstChild("ActiveBar")
			if activeBar then
				activeBar.Visible = isActive
			end
		end
	end

	showTab = function(name)
		if not pages[name] then
			return
		end
		activeTab = name
		for tabName, page in pairs(pages) do
			page.Visible = (tabName == name)
		end
		paintTabs()
		closeDropdown()
		if name == "Panel" then
			updateDashboard()
		elseif name == "Oyuncaklar" then
			if uiRefs.toys.refresh then
				uiRefs.toys.refresh()
			end
		elseif name == "Oyuncular" then
			features.updatePlayers()
		end
	end

	for index, name in ipairs(tabOrder) do
		local tabName = name
		local page = create("ScrollingFrame", {
			Name = "Page_" .. name,
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
