	local heldOriginal = nil
	local heldScanAt = 0

	local function findHeldOriginal()
		if os.clock() - heldScanAt < 0.5 and heldOriginal and heldOriginal.Parent then
			return heldOriginal
		end
		heldScanAt = os.clock()
		heldOriginal = nil
		for _, model in ipairs(workspace:GetChildren()) do
			if model:IsA("Model") and not Players:GetPlayerFromCharacter(model) then
				local holdPart = model:FindFirstChild("HoldPart")
				if holdPart and holdPart:IsA("BasePart") then
					if holdPart.Transparency >= 0.99 and not holdPart.Anchored then
						heldOriginal = model
						break
					end
				end
			end
		end
		return heldOriginal
	end

	local function useHeldItem(silent)
		local model = findHeldOriginal()
		if not model then
			if not silent then
				notify("Kullan", "Elinde kullanılabilir eşya bulunamadı.", 3, theme.warn)
			end
			return false
		end
		safeFire("HoldUse", model)
		if not silent then
			notify("Kullan", model.Name .. " kullanıldı.", 2, theme.good)
		end
		return true
	end
