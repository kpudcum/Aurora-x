	refreshToys = function()
		if not rowsHolder then
			return
		end
		for _, child in ipairs(rowsHolder:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		if #toyNames == 0 then
			toyCountLabel.Text = "Katalog yüklenmedi"
			listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
			return
		end
		local search = string.lower(toySearch or "")
		local category = toyFilterCategory or "Tümü"
		local filtered = {}
		for _, name in ipairs(toyNames) do
			local data = allToysData[name] or {}
			local displayName = data.FakeName or name
			local matches = true
			if search ~= "" then
				local haystack = string.lower(name .. " " .. tostring(displayName) .. " " .. tostring(data.Description or ""))
				matches = string.find(haystack, search, 1, true) ~= nil
			end
			if matches then
				if category == "Sahip Olunanlar" then
					matches = state.ownedSet[name] == true
				elseif category == "Favoriler" then
					matches = state.favoriteSet[name] == true
				elseif category ~= "Tümü" then
					matches = toyCategory[name] == category
				end
			end
			if matches then
				table.insert(filtered, name)
			end
		end
		table.sort(filtered, function(a, b)
			local af = state.favoriteSet[a] and 1 or 0
			local bf = state.favoriteSet[b] and 1 or 0
			if af ~= bf then
				return af > bf
			end
			local ao = state.ownedSet[a] and 1 or 0
			local bo = state.ownedSet[b] and 1 or 0
			if ao ~= bo then
				return ao > bo
			end
			return a < b
		end)
		local limit = math.min(#filtered, 250)
		for index = 1, limit do
			createToyRow(filtered[index], index)
		end
		toyCountLabel.Text = tostring(#filtered) .. " sonuç" .. (#filtered > 250 and " (ilk 250)" or "")
		listFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(70, limit * 70 + 10))
		listFrame.CanvasPosition = Vector2.new(0, 0)
	end

