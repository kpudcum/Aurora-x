		local box = uiRefs.players and uiRefs.players.container
		if not box then
			return
		end
		local myRoot = hrp
		local myPos = myRoot and myRoot.Position or Vector3.new(0, 0, 0)
		local seen = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				seen[plr] = true
				local row = playerRows[plr]
				if not row or not row.frame or not row.frame.Parent then
					row = createPlayerRow(plr)
					playerRows[plr] = row
				end
				if row then
					local char = plr.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					local root = char and char:FindFirstChild("HumanoidRootPart")
					local dist = root and math.floor((root.Position - myPos).Magnitude) or 0
					local held = false
					local isHeld = plr:FindFirstChild("IsHeld")
					if isHeld and isHeld:IsA("BoolValue") then
						held = isHeld.Value
					end
					row.nameLabel.Text = plr.Name
					if hum and hum.Health > 0 then
						row.infoLabel.Text = string.format("HP %d  •  %d stud%s", math.floor(hum.Health), dist, held and "  •  TUTULUYOR" or "")
						row.infoLabel.TextColor3 = held and theme.bad or theme.subtext
					else
						row.infoLabel.Text = "Ölü / karakter yok"
						row.infoLabel.TextColor3 = theme.warn
					end
					local grabText = ""
					local gp = char and char:FindFirstChild("GrabParts")
					local gpart = gp and gp:FindFirstChild("GrabPart")
					local weld = gpart and gpart:FindFirstChild("WeldConstraint")
					if weld and weld.Part1 then
						grabText = "Tutuyor: " .. weld.Part1.Name
					end
					row.grabLabel.Text = grabText
					if state.spectating == plr then
						row.watchBtn.Text = "Bırak"
						row.watchBtn.BackgroundColor3 = theme.accent
					else
						row.watchBtn.Text = "İzle"
						row.watchBtn.BackgroundColor3 = theme.panel3
					end
				end
			end
		end
		for plr, row in pairs(playerRows) do
			if not seen[plr] then
				if row and row.frame then
					row.frame:Destroy()
				end
				playerRows[plr] = nil
			end
		end
		if state.spectating and (not state.spectating.Parent or not state.spectating.Character) then
			state.spectating = nil
			local cam = workspace.CurrentCamera
			if cam then
				cam.CameraSubject = humanoid
				cam.CameraType = Enum.CameraType.Custom
			end
		end
	end

