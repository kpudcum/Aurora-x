	local function colorRow(parent, labelText, colors, getter, setter)
		local row = makeRow(parent, 52)
		create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 18),
			BackgroundTransparency = 1,
			Text = labelText,
			TextColor3 = theme.text,
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row)
		local holder = create("Frame", {
			Size = UDim2.new(1, 0, 0, 22),
			Position = UDim2.new(0, 0, 0, 23),
			BackgroundTransparency = 1,
		}, row)
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, holder)
		local swatches = {}
		local function colorEq(a, b)
			return math.abs(a.R - b.R) < 0.01 and math.abs(a.G - b.G) < 0.01 and math.abs(a.B - b.B) < 0.01
		end
		local function paint()
			local current = getter()
			for index, swatch in ipairs(swatches) do
				local selected = current and colorEq(current, colors[index].color)
				swatch.stroke.Color = selected and Color3.fromRGB(255, 255, 255) or theme.border
				swatch.stroke.Thickness = selected and 2 or 1
			end
		end
		for index, item in ipairs(colors) do
			local colorValue = item.color
			local btn = create("TextButton", {
				Size = UDim2.new(0, 20, 0, 20),
				BackgroundColor3 = colorValue,
				BorderSizePixel = 0,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = index,
			}, holder)
			corner(btn, 4)
			local st = stroke(btn, theme.border, 1)
			swatches[index] = { button = btn, stroke = st }
			btn.Activated:Connect(function()
				setter(colorValue)
				paint()
				saveConfig()
			end)
		end
		paint()
		table.insert(uiRefs.colors, {
			sync = paint,
		})
	end

