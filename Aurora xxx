	-- ---------------- OTO FIRLATMA / OTO BUTON (ARKADAN IŞINLAN + FIRLAT + BIRAK) ----------------

	local autoFlingBusy = false

	local function flingTargetPlayerOnce(targetPlayer)
		if not targetPlayer or targetPlayer == LocalPlayer then
			return false
		end
		local tChar = targetPlayer.Character
		local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
		local tTorso = tChar and (tChar:FindFirstChild("Torso") or tChar:FindFirstChild("UpperTorso"))
		local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
		if not (tHRP and tHum and tHum.Health > 0 and hrp and hrp.Parent) then
			return false
		end

		local grabTarget = tTorso or tHRP
		local cam = workspace.CurrentCamera
		local power = math.clamp(tonumber(config.autoFlingPower) or 1600, 200, 4500)

		-- 1) Hedefin arkasına ışınlan ve NetworkOwner alana kadar yakın kal
		local behindCF = tHRP.CFrame * CFrame.new(0, 0.4, 2.8)
		hrp.CFrame = CFrame.lookAt(behindCF.Position, tHRP.Position)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero

		safeFire("CreateGrabLine", grabTarget, CFrame.new())
		safeFire("ExtendGrabLine", 20)
		safeFire("SetNetworkOwner", grabTarget, cam and cam.CFrame or hrp.CFrame)
		task.wait(0.11)

		if not (tHRP and tHRP.Parent and hrp and hrp.Parent) then
			return false
		end
		-- NetworkOwnership oturması için ikinci doğrulama
		safeFire("SetNetworkOwner", grabTarget, cam and cam.CFrame or hrp.CFrame)
		task.wait(0.11)

		-- 2) Işınlanmayı durdurup güçlü ve sürekli fırlatma uygula
		if tHRP and tHRP.Parent and tHRP:IsDescendantOf(workspace) then
			local lookDir = hrp and hrp.CFrame.LookVector or (cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1))
			local flingDir = (Vector3.new(lookDir.X, 0, lookDir.Z).Unit + Vector3.new(0, 0.72, 0)).Unit
			local vel = flingDir * power
			local parts = getAssemblyParts(tHRP)

			-- Güçlü itiş için geçici BodyVelocity
			local bv = Instance.new("BodyVelocity")
			bv.Name = "SC4AutoFlingBV"
			bv.MaxForce = Vector3.new(1e7, 1e7, 1e7)
			bv.P = 1e5
			bv.Velocity = vel
			bv.Parent = tHRP

			local launchEnd = os.clock() + 0.35
			while os.clock() < launchEnd and not unloaded do
				if not (tHRP and tHRP.Parent and tHRP:IsDescendantOf(workspace)) then
					break
				end
				bv.Velocity = vel
				for _, p in ipairs(parts) do
					if p:IsA("BasePart") and not p.Anchored then
						p.AssemblyLinearVelocity = vel
						p.AssemblyAngularVelocity = Vector3.new(90, 160, 90)
					end
				end
				RunService.Heartbeat:Wait()
			end

			if bv and bv.Parent then
				bv:Destroy()
			end

			-- 3) Bırak
			safeFire("DestroyGrabLine", grabTarget)
			addLog("Oto Fırlat: " .. targetPlayer.Name .. " (" .. tostring(math.floor(power)) .. " stud/s)", theme.accent)
			return true
		end
		return false
	end

	features.autoFlingOnce = function()
		if autoFlingBusy then
