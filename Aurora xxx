		}, row)
		local valueLabel = create("TextLabel", {
			Size = UDim2.new(0, 90, 0, 16),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			BackgroundTransparency = 1,
			Text = "",
			TextColor3 = theme.accent,
			Font = Enum.Font.Code,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Right,
		}, row)
		local track = create("Frame", {
			Size = UDim2.new(1, 0, 0, 6),
			Position = UDim2.new(0, 0, 0, 30),
			BackgroundColor3 = theme.panel3,
			BorderSizePixel = 0,
		}, row)
		corner(track, 3)
		local fill = create("Frame", {
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = theme.accent,
			BorderSizePixel = 0,
		}, track)
		corner(fill, 3)
		local knob = create("Frame", {
			Size = UDim2.new(0, 12, 0, 12),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			BackgroundColor3 = theme.text,
			BorderSizePixel = 0,
		}, track)
		corner(knob, 6)
		local hit = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 20),
			Position = UDim2.new(0, 0, 0, 23),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
		}, row)

		local function paint(value)
			local ratio = math.clamp((value - min) / (max - min), 0, 1)
			fill.Size = UDim2.new(ratio, 0, 1, 0)
			knob.Position = UDim2.new(ratio, 0, 0.5, 0)
			valueLabel.Text = formatFn and formatFn(value) or numFormat(value)
		end

		local function updateFromX(x)
			local width = math.max(track.AbsoluteSize.X, 1)
			local ratio = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
			local raw = min + (max - min) * ratio
			local steps = math.floor((raw - min) / step + 0.5)
			local value = min + steps * step
			value = math.clamp(value, min, max)
			if step >= 1 then
				value = math.floor(value + 0.5)
			else
				value = tonumber(string.format("%.2f", value))
			end
			setter(value)
			paint(value)
			saveConfig()
		end

		hit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				activeSlider = updateFromX
				updateFromX(input.Position.X)
			end
		end)

		paint(getter())
		table.insert(uiRefs.sliders, {
			sync = function()
				paint(getter())
			end,
		})
	end

	connect(UserInputService.InputChanged, function(input)
