--[[
	NOVA UI  -  premium script arayuzu (PC + mobil)
	Kullanim: LocalScript / executor. Dosyanin en altinda ornek menu var, silip kendi menunu yazabilirsin.
	API:
		local Win = Nova.new({ Title = "Nova", Subtitle = "v1", Accent = Color3.fromRGB(124,92,255) })
		local Tab = Win:AddTab("Main")
		local Sec = Tab:AddSection("Combat")
		Sec:AddToggle({ Name, Default, Callback })
		Sec:AddSlider({ Name, Min, Max, Default, Step, Suffix, Callback })
		Sec:AddButton({ Name, Callback })
		Sec:AddDropdown({ Name, Options, Default, Callback })
		Sec:AddKeybind({ Name, Default (Enum.KeyCode), Callback })
		Sec:AddTextbox({ Name, Placeholder, Callback })
		Sec:AddLabel(text)
		Win:Notify({ Title, Content, Duration, Type = "info" | "success" | "warn" | "error" })
		Win:SetAccent(Color3)  Win:Toggle()  Win:Destroy()
]]

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local lp = Players.LocalPlayer
local camera = workspace.CurrentCamera
local isMobile = UIS.TouchEnabled and not UIS.MouseEnabled

local theme = {
	bg0 = Color3.fromRGB(17, 18, 28),
	bg1 = Color3.fromRGB(9, 10, 16),
	card = Color3.fromRGB(23, 25, 38),
	row = Color3.fromRGB(30, 33, 49),
	row2 = Color3.fromRGB(42, 46, 67),
	line = Color3.fromRGB(54, 59, 84),
	text = Color3.fromRGB(240, 242, 250),
	sub = Color3.fromRGB(152, 160, 186),
	dim = Color3.fromRGB(98, 106, 132),
	ok = Color3.fromRGB(72, 214, 150),
	warn = Color3.fromRGB(246, 187, 78),
	err = Color3.fromRGB(255, 104, 120),
}

local Nova = { Accent = Color3.fromRGB(124, 92, 255) }

------------------------------------------------------------------ yardimcilar
local function tw(o, t, p, style, dir)
	local tween = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), p)
	tween:Play()
	return tween
end

local function mk(class, props, kids)
	local o = Instance.new(class)
	local par = props and props.Parent
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then o[k] = v end
		end
	end
	for _, c in ipairs(kids or {}) do c.Parent = o end
	if par then o.Parent = par end
	return o
end

local function corner(r) return mk("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function stroke(c, t, tr) return mk("UIStroke", { Color = c, Thickness = t or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) end
local function pad(l, t, r, b) return mk("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b) }) end
local function vlist(gap) return mk("UIListLayout", { Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder }) end

local function txt(p)
	p.BackgroundTransparency = 1
	p.Font = p.Font or Enum.Font.GothamMedium
	p.TextSize = p.TextSize or 13
	p.TextColor3 = p.TextColor3 or theme.text
	p.TextXAlignment = p.TextXAlignment or Enum.TextXAlignment.Left
	return mk("TextLabel", p)
end

local function guiParent()
	local ok, h = pcall(function() return gethui and gethui() end)
	if ok and h then return h end
	return lp:WaitForChild("PlayerGui")
end

------------------------------------------------------------------ pencere
function Nova.new(cfg)
	cfg = cfg or {}
	if cfg.Accent then Nova.Accent = cfg.Accent end
	local W, H = 660, 430
	local TOP, SIDE = 54, 168
	local Win = {}
	local conns, accentSet, accentGrads = {}, {}, {}

	local function keep(c) table.insert(conns, c) return c end
	local function bindAccent(inst, prop)
		inst[prop] = Nova.Accent
		table.insert(accentSet, { inst, prop })
	end
	local function accentGradient(parent, rot)
		local g = mk("UIGradient", { Rotation = rot or 0, Parent = parent })
		local function paint()
			local h, s, v = Nova.Accent:ToHSV()
			g.Color = ColorSequence.new(Nova.Accent, Color3.fromHSV((h + 0.08) % 1, s, v))
		end
		paint()
		table.insert(accentGrads, paint)
		return g
	end

	local parentUi = guiParent()
	local old = parentUi:FindFirstChild("NovaUI")
	if old then old:Destroy() end
	local oldBlur = Lighting:FindFirstChild("NovaBlur")
	if oldBlur then oldBlur:Destroy() end

	local gui = mk("ScreenGui", { Name = "NovaUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 500, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = parentUi })
	local blur = mk("BlurEffect", { Name = "NovaBlur", Size = 0, Parent = Lighting })

	------------------------------------------------ ana kutu
	local holder = mk("Frame", { Name = "Holder", Size = UDim2.fromOffset(0, 0), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Visible = false, Parent = gui })
	local box = mk("Frame", { Size = UDim2.fromOffset(W, H), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = holder })
	local scale = mk("UIScale", { Scale = 0.8, Parent = box })
	local customScale

	local function baseScale()
		if customScale then return customScale end
		local vp = camera.ViewportSize
		local s = math.min((vp.X - 24) / W, (vp.Y - 24) / H)
		if isMobile then return math.clamp(s, 0.45, 0.78) end
		return math.clamp(s, 0.6, 1.05)
	end

	local shadow = mk("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 100, 1, 100), BackgroundTransparency = 1, Image = "rbxassetid://6014261993", ImageColor3 = Color3.new(0, 0, 0), ImageTransparency = 1, ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450), ZIndex = 0, Parent = box })

	local main = mk("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, GroupTransparency = 1, Parent = box }, {
		corner(16),
		mk("UIGradient", { Rotation = 90, Color = ColorSequence.new(theme.bg0, theme.bg1) }),
	})

	-- hareketli renkli cerceve
	local border = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 20, Parent = main }, { corner(16) })
	local bs = stroke(Color3.new(1, 1, 1), 1.5, 0)
	local bg = mk("UIGradient", { Parent = bs })
	bs.Parent = border
	local function paintBorder()
		local h, s, v = Nova.Accent:ToHSV()
		local c2 = Color3.fromHSV((h + 0.12) % 1, s, v)
		bg.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Nova.Accent), ColorSequenceKeypoint.new(0.35, theme.line),
			ColorSequenceKeypoint.new(0.65, theme.line), ColorSequenceKeypoint.new(1, c2),
		})
	end
	paintBorder()
	table.insert(accentGrads, paintBorder)
	keep(RunService.Heartbeat:Connect(function() bg.Rotation = (os.clock() * 40) % 360 end))

	-- arka plan isiklari
	local glow1 = mk("Frame", { Size = UDim2.fromOffset(340, 340), Position = UDim2.fromOffset(-120, -150), BackgroundTransparency = 0.9, BorderSizePixel = 0, Parent = main }, { corner(170) })
	local glow2 = mk("Frame", { Size = UDim2.fromOffset(300, 300), Position = UDim2.new(1, -150, 1, -130), BackgroundTransparency = 0.93, BorderSizePixel = 0, Parent = main }, { corner(150) })
	bindAccent(glow1, "BackgroundColor3")
	bindAccent(glow2, "BackgroundColor3")
	keep(RunService.Heartbeat:Connect(function()
		local t = os.clock()
		glow1.Position = UDim2.fromOffset(-120 + math.sin(t * 0.6) * 18, -150 + math.cos(t * 0.5) * 14)
		glow2.Position = UDim2.new(1, -150 + math.cos(t * 0.55) * 16, 1, -130 + math.sin(t * 0.7) * 14)
	end))

	------------------------------------------------ ust cubuk
	local top = mk("Frame", { Size = UDim2.new(1, 0, 0, TOP), BackgroundTransparency = 1, ZIndex = 5, Parent = main })
	mk("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = theme.line, BackgroundTransparency = 0.4, BorderSizePixel = 0, Parent = top })

	local logo = mk("Frame", { Size = UDim2.fromOffset(32, 32), Position = UDim2.fromOffset(18, 11), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = top }, { corner(10) })
	accentGradient(logo, 45)
	txt({ Text = string.upper(string.sub(cfg.Title or "N", 1, 1)), Font = Enum.Font.GothamBlack, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = logo })
	local titleL = txt({ Text = cfg.Title or "Nova", Font = Enum.Font.GothamBold, TextSize = 16, Size = UDim2.fromOffset(200, 18), Position = UDim2.fromOffset(60, 10), Parent = top })
	txt({ Text = cfg.Subtitle or "premium", TextSize = 11, TextColor3 = theme.dim, Size = UDim2.fromOffset(200, 14), Position = UDim2.fromOffset(60, 29), Parent = top })

	local function topBtn(label, x, hoverCol)
		local b = mk("TextButton", { Text = label, Size = UDim2.fromOffset(30, 30), Position = UDim2.new(1, x, 0, 12), BackgroundColor3 = hoverCol, BackgroundTransparency = 1, TextColor3 = theme.sub, Font = Enum.Font.GothamBold, TextSize = 14, AutoButtonColor = false, Parent = top }, { corner(9) })
		b.MouseEnter:Connect(function() tw(b, 0.15, { BackgroundTransparency = 0.55, TextColor3 = theme.text }) end)
		b.MouseLeave:Connect(function() tw(b, 0.15, { BackgroundTransparency = 1, TextColor3 = theme.sub }) end)
		return b
	end
	local closeB = topBtn("X", -42, theme.err)
	local minB = topBtn("-", -76, theme.row2)

	------------------------------------------------ yan menu + sayfalar
	local side = mk("Frame", { Size = UDim2.new(0, SIDE, 1, -TOP), Position = UDim2.fromOffset(0, TOP), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.72, BorderSizePixel = 0, Parent = main })
	mk("Frame", { Size = UDim2.new(0, 1, 1, -TOP), Position = UDim2.fromOffset(SIDE, TOP), BackgroundColor3 = theme.line, BackgroundTransparency = 0.4, BorderSizePixel = 0, Parent = main })

	local tabList = mk("Frame", { Size = UDim2.new(1, -16, 1, -20), Position = UDim2.fromOffset(8, 10), BackgroundTransparency = 1, Parent = side })
	local pill = mk("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 0.82, BorderSizePixel = 0, Visible = false, Parent = tabList }, { corner(10) })
	bindAccent(pill, "BackgroundColor3")
	local bar = mk("Frame", { Size = UDim2.fromOffset(3, 18), Position = UDim2.new(0, 0, 0.5, -9), BorderSizePixel = 0, Parent = pill }, { corner(2) })
	bindAccent(bar, "BackgroundColor3")

	local pages = mk("Frame", { Size = UDim2.new(1, -SIDE - 1, 1, -TOP), Position = UDim2.fromOffset(SIDE + 1, TOP), BackgroundTransparency = 1, ClipsDescendants = true, Parent = main })

	local tabs, current = {}, nil
	local function selectTab(t)
		if current == t then return end
		current = t
		pill.Visible = true
		tw(pill, 0.35, { Position = UDim2.fromOffset(0, (t.index - 1) * 44) }, Enum.EasingStyle.Quint)
		for _, o in ipairs(tabs) do
			local on = o == t
			tw(o.label, 0.2, { TextColor3 = on and theme.text or theme.sub })
			tw(o.dia, 0.2, { BackgroundColor3 = on and Nova.Accent or theme.dim })
			if not on then o.page.Visible = false end
		end
		t.page.Position = UDim2.fromOffset(0, 14)
		t.page.Visible = true
		tw(t.page, 0.35, { Position = UDim2.fromOffset(0, 0) })
	end

	------------------------------------------------ bildirimler
	local toastHolder = mk("Frame", { Size = UDim2.new(0, 290, 1, -30), Position = UDim2.new(1, -306, 0, 15), BackgroundTransparency = 1, Parent = gui }, {
		mk("UIListLayout", { Padding = UDim.new(0, 10), VerticalAlignment = Enum.VerticalAlignment.Bottom, SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local toastN = 0
	function Win:Notify(o)
		o = o or {}
		local kinds = { success = theme.ok, warn = theme.warn, error = theme.err }
		local col = kinds[o.Type]
		local dur = o.Duration or 4
		toastN = toastN + 1
		local slot = mk("Frame", { Size = UDim2.new(1, 0, 0, 66), BackgroundTransparency = 1, LayoutOrder = toastN, Parent = toastHolder })
		local card = mk("Frame", { Size = UDim2.fromScale(1, 1), Position = UDim2.new(1.2, 0, 0, 0), BackgroundColor3 = theme.card, BorderSizePixel = 0, ClipsDescendants = true, Parent = slot }, { corner(12), stroke(theme.line, 1, 0.3) })
		local strip = mk("Frame", { Size = UDim2.new(0, 3, 1, 0), BorderSizePixel = 0, Parent = card })
		if col then strip.BackgroundColor3 = col else bindAccent(strip, "BackgroundColor3") end
		txt({ Text = o.Title or "Nova", Font = Enum.Font.GothamBold, TextSize = 13, Size = UDim2.new(1, -28, 0, 16), Position = UDim2.fromOffset(16, 10), Parent = card })
		txt({ Text = o.Content or "", TextSize = 12, TextColor3 = theme.sub, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, -28, 0, 28), Position = UDim2.fromOffset(16, 28), Parent = card })
		local prog = mk("Frame", { Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2), BorderSizePixel = 0, Parent = card })
		if col then prog.BackgroundColor3 = col else bindAccent(prog, "BackgroundColor3") end
		tw(card, 0.5, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
		tw(prog, dur, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
		task.delay(dur, function()
			if not card.Parent then return end
			tw(card, 0.35, { Position = UDim2.new(1.2, 0, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Wait()
			slot:Destroy()
		end)
	end

	------------------------------------------------ sekme / bolum / elemanlar
	function Win:AddTab(name)
		local idx = #tabs + 1
		local btn = mk("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 38), Position = UDim2.fromOffset(0, (idx - 1) * 44), BackgroundTransparency = 1, AutoButtonColor = false, ZIndex = 3, Parent = tabList })
		local dia = mk("Frame", { Size = UDim2.fromOffset(8, 8), Position = UDim2.new(0, 16, 0.5, -4), Rotation = 45, BackgroundColor3 = theme.dim, BorderSizePixel = 0, Parent = btn })
		local lbl = txt({ Text = name, Font = Enum.Font.GothamBold, TextColor3 = theme.sub, Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -44, 1, 0), Parent = btn })
		btn.MouseEnter:Connect(function() if current and current.btn ~= btn then tw(lbl, 0.15, { TextColor3 = theme.text }) end end)
		btn.MouseLeave:Connect(function() if current and current.btn ~= btn then tw(lbl, 0.15, { TextColor3 = theme.sub }) end end)

		local page = mk("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = theme.line, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, Parent = pages }, { pad(16, 14, 16, 14), vlist(12) })

		local tab = { index = idx, btn = btn, dia = dia, label = lbl, page = page }
		table.insert(tabs, tab)
		btn.MouseButton1Click:Connect(function() selectTab(tab) end)
		if idx == 1 then task.defer(selectTab, tab) end

		local Tab = {}
		function Tab:AddSection(title)
			local card = mk("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = theme.card, BackgroundTransparency = 0.1, BorderSizePixel = 0, LayoutOrder = #page:GetChildren(), Parent = page }, { corner(12), stroke(theme.line, 1, 0.45), pad(12, 10, 12, 12), vlist(8) })
			local order = 0
			local head = mk("Frame", { Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, LayoutOrder = 0, Parent = card })
			local dot = mk("Frame", { Size = UDim2.fromOffset(6, 6), Position = UDim2.new(0, 0, 0.5, -3), BorderSizePixel = 0, Parent = head }, { corner(3) })
			bindAccent(dot, "BackgroundColor3")
			txt({ Text = string.upper(title), Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = theme.sub, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -14, 1, 0), Parent = head })

			local function row(h, clip)
				order = order + 1
				local r = mk("Frame", { Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = theme.row, BorderSizePixel = 0, ClipsDescendants = clip or false, LayoutOrder = order, Parent = card }, { corner(9) })
				r.MouseEnter:Connect(function() tw(r, 0.15, { BackgroundColor3 = theme.row2 }) end)
				r.MouseLeave:Connect(function() tw(r, 0.15, { BackgroundColor3 = theme.row }) end)
				return r
			end
			local function rowLabel(r, text, w)
				return txt({ Text = text, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(w or 1, -28, 0, 38), Parent = r })
			end

			local Sec = {}

			function Sec:AddLabel(text)
				local r = row(30)
				r.BackgroundTransparency = 1
				txt({ Text = text, TextSize = 12, TextColor3 = theme.sub, TextWrapped = true, Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(4, 0), Parent = r })
			end

			function Sec:AddButton(o)
				local r = row(38, true)
				local b = mk("TextButton", { Text = o.Name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = theme.text, AutoButtonColor = false, Parent = r })
				txt({ Text = ">", Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = theme.dim, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(30, 38), Position = UDim2.new(1, -36, 0, 0), Parent = r })
				b.InputBegan:Connect(function(i)
					if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
					local rip = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset((i.Position.X - r.AbsolutePosition.X) / scale.Scale, (i.Position.Y - r.AbsolutePosition.Y) / scale.Scale), Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 0.55, BorderSizePixel = 0, Parent = r }, { corner(200) })
					bindAccent(rip, "BackgroundColor3")
					tw(rip, 0.6, { Size = UDim2.fromOffset(360, 360), BackgroundTransparency = 1 }).Completed:Connect(function() rip:Destroy() end)
				end)
				b.MouseButton1Click:Connect(function() if o.Callback then task.spawn(o.Callback) end end)
			end

			function Sec:AddToggle(o)
				local state = o.Default and true or false
				local r = row(38)
				rowLabel(r, o.Name, 1)
				local track = mk("TextButton", { Text = "", Size = UDim2.fromOffset(42, 22), Position = UDim2.new(1, -56, 0.5, -11), BackgroundColor3 = theme.row2, AutoButtonColor = false, BorderSizePixel = 0, Parent = r }, { corner(11) })
				local knob = mk("Frame", { Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = track }, { corner(8) })
				local function paint(anim)
					local d = anim and 0.22 or 0
					tw(track, d, { BackgroundColor3 = state and Nova.Accent or theme.line })
					tw(knob, d, { Position = state and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3) }, Enum.EasingStyle.Back)
				end
				paint(false)
				table.insert(accentGrads, function() if state then track.BackgroundColor3 = Nova.Accent end end)
				track.MouseButton1Click:Connect(function()
					state = not state
					paint(true)
					if o.Callback then task.spawn(o.Callback, state) end
				end)
				return { Set = function(v) state = v and true or false paint(true) if o.Callback then task.spawn(o.Callback, state) end end, Get = function() return state end }
			end

			function Sec:AddSlider(o)
				local min, max, step = o.Min or 0, o.Max or 100, o.Step or 1
				local value = math.clamp(o.Default or min, min, max)
				local r = row(56)
				rowLabel(r, o.Name, 0.6)
				local vl = txt({ Font = Enum.Font.Code, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.4, -14, 0, 38), Position = UDim2.new(0.6, 0, 0, 0), TextColor3 = theme.sub, Parent = r })
				local track = mk("Frame", { Size = UDim2.new(1, -28, 0, 6), Position = UDim2.fromOffset(14, 40), BackgroundColor3 = theme.bg1, BorderSizePixel = 0, Parent = r }, { corner(3) })
				local fill = mk("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = track }, { corner(3) })
				accentGradient(fill, 0)
				local knob = mk("Frame", { Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = fill }, { corner(7) })
				local ks = stroke(Nova.Accent, 3, 0.55)
				ks.Parent = knob
				bindAccent(ks, "Color")
				local function show()
					local rel = (value - min) / (max - min)
					vl.Text = (step < 1 and string.format("%.2f", value) or tostring(value)) .. (o.Suffix or "")
					tw(fill, 0.08, { Size = UDim2.fromScale(rel, 1) })
				end
				local function setX(x)
					local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
					local v = math.floor((min + (max - min) * rel) / step + 0.5) * step
					v = math.clamp(v, min, max)
					if v ~= value then
						value = v
						show()
						if o.Callback then o.Callback(value) end
					end
				end
				local dragging = false
				track.InputBegan:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
						dragging = true
						page.ScrollingEnabled = false
						tw(knob, 0.12, { Size = UDim2.fromOffset(18, 18) })
						setX(i.Position.X)
					end
				end)
				keep(UIS.InputChanged:Connect(function(i)
					if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then setX(i.Position.X) end
				end))
				keep(UIS.InputEnded:Connect(function(i)
					if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
						dragging = false
						page.ScrollingEnabled = true
						tw(knob, 0.12, { Size = UDim2.fromOffset(14, 14) })
					end
				end))
				show()
				return { Set = function(v) value = math.clamp(v, min, max) show() if o.Callback then o.Callback(value) end end, Get = function() return value end }
			end

			function Sec:AddDropdown(o)
				local opts = o.Options or {}
				local cur = o.Default or opts[1]
				local itemH = 30
				local openH = 38 + #opts * (itemH + 3) + 8
				local r = row(38, true)
				local head2 = mk("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, AutoButtonColor = false, Parent = r })
				txt({ Text = o.Name, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0.5, 0, 1, 0), Parent = head2 })
				local curL = txt({ Text = tostring(cur), TextSize = 12, TextColor3 = theme.sub, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0.5, -40, 1, 0), Parent = head2 })
				local arrow = txt({ Text = "v", TextSize = 12, TextColor3 = theme.dim, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(1, -30, 0, 0), Size = UDim2.fromOffset(24, 38), Parent = head2 })
				local list = mk("Frame", { Size = UDim2.new(1, -12, 0, #opts * (itemH + 3)), Position = UDim2.fromOffset(6, 42), BackgroundTransparency = 1, Parent = r }, { vlist(3) })
				local btns = {}
				local function paint()
					for name, b in pairs(btns) do
						local on = name == cur
						tw(b, 0.15, { TextColor3 = on and theme.text or theme.sub, BackgroundTransparency = on and 0.8 or 1 })
					end
				end
				for _, name in ipairs(opts) do
					local b = mk("TextButton", { Text = tostring(name), Size = UDim2.new(1, 0, 0, itemH), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = theme.sub, AutoButtonColor = false, Parent = list }, { corner(7) })
					bindAccent(b, "BackgroundColor3")
					b.MouseButton1Click:Connect(function()
						cur = name
						curL.Text = tostring(name)
						paint()
						if o.Callback then task.spawn(o.Callback, name) end
					end)
					btns[name] = b
				end
				paint()
				local open = false
				head2.MouseButton1Click:Connect(function()
					open = not open
					tw(r, 0.3, { Size = UDim2.new(1, 0, 0, open and openH or 38) })
					tw(arrow, 0.25, { Rotation = open and 180 or 0 })
				end)
				return { Get = function() return cur end, Set = function(v) if btns[v] then cur = v curL.Text = tostring(v) paint() if o.Callback then task.spawn(o.Callback, v) end end end }
			end

			function Sec:AddKeybind(o)
				local key = o.Default
				local listening = false
				local r = row(38)
				rowLabel(r, o.Name, 1)
				local kb = mk("TextButton", { Text = key and key.Name or "None", Size = UDim2.fromOffset(88, 26), Position = UDim2.new(1, -102, 0.5, -13), BackgroundColor3 = theme.bg1, Font = Enum.Font.Code, TextSize = 12, TextColor3 = theme.sub, AutoButtonColor = false, BorderSizePixel = 0, Parent = r }, { corner(8), stroke(theme.line, 1, 0.3) })
				kb.MouseButton1Click:Connect(function()
					listening = true
					kb.Text = "..."
					kb.TextColor3 = Nova.Accent
				end)
				keep(UIS.InputBegan:Connect(function(i, gp)
					if listening and i.UserInputType == Enum.UserInputType.Keyboard then
						listening = false
						key = i.KeyCode ~= Enum.KeyCode.Escape and i.KeyCode or nil
						kb.Text = key and key.Name or "None"
						kb.TextColor3 = theme.sub
					elseif not gp and key and i.KeyCode == key and not UIS:GetFocusedTextBox() then
						if o.Callback then task.spawn(o.Callback, key) end
					end
				end))
				return { Get = function() return key end }
			end

			function Sec:AddTextbox(o)
				local r = row(38)
				rowLabel(r, o.Name, 0.45)
				local tb = mk("TextBox", { Size = UDim2.new(0.55, -22, 0, 26), Position = UDim2.new(0.45, 8, 0.5, -13), BackgroundColor3 = theme.bg1, BorderSizePixel = 0, Text = "", PlaceholderText = o.Placeholder or "...", PlaceholderColor3 = theme.dim, TextColor3 = theme.text, Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false, Parent = r }, { corner(8), pad(10, 0, 10, 0) })
				local st = stroke(theme.line, 1, 0.3)
				st.Parent = tb
				tb.Focused:Connect(function() tw(st, 0.2, { Color = Nova.Accent, Transparency = 0 }) end)
				tb.FocusLost:Connect(function(enter)
					tw(st, 0.2, { Color = theme.line, Transparency = 0.3 })
					if o.Callback then task.spawn(o.Callback, tb.Text, enter) end
				end)
			end

			return Sec
		end
		return Tab
	end

	------------------------------------------------ ac / kapa, surukle, launcher
	local visible = false
	local launcher = mk("TextButton", { Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -18), Size = UDim2.fromOffset(54, 54), BackgroundColor3 = theme.bg0, BorderSizePixel = 0, Visible = false, Parent = gui }, { corner(18) })
	local lst = stroke(Nova.Accent, 1.6, 0.1)
	lst.Parent = launcher
	bindAccent(lst, "Color")
	local lg = mk("Frame", { Size = UDim2.fromOffset(32, 32), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = launcher }, { corner(10) })
	accentGradient(lg, 45)
	local lscale = mk("UIScale", { Scale = 1, Parent = launcher })
	launcher.MouseEnter:Connect(function() tw(lscale, 0.15, { Scale = 1.1 }) end)
	launcher.MouseLeave:Connect(function() tw(lscale, 0.15, { Scale = 1 }) end)

	local function setVisible(v)
		visible = v
		if v then
			holder.Visible = true
			launcher.Visible = false
			tw(scale, 0.5, { Scale = baseScale() }, Enum.EasingStyle.Back)
			tw(main, 0.3, { GroupTransparency = 0 })
			tw(shadow, 0.4, { ImageTransparency = 0.35 })
			tw(blur, 0.4, { Size = 12 })
		else
			tw(scale, 0.25, { Scale = baseScale() * 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tw(main, 0.22, { GroupTransparency = 1 })
			tw(shadow, 0.22, { ImageTransparency = 1 })
			tw(blur, 0.3, { Size = 0 })
			task.delay(0.26, function()
				if not visible then
					holder.Visible = false
					launcher.Visible = true
				end
			end)
		end
	end
	function Win:Toggle() setVisible(not visible) end

	local moved = false
	do -- launcher surukleme
		local drag, startIn, startPos
		launcher.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				drag, moved, startIn, startPos = true, false, i.Position, launcher.Position
			end
		end)
		keep(UIS.InputChanged:Connect(function(i)
			if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				local d = i.Position - startIn
				if d.Magnitude > 8 then moved = true end
				if moved then launcher.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y) end
			end
		end))
		keep(UIS.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end
		end))
	end
	launcher.MouseButton1Click:Connect(function()
		if moved then moved = false return end
		setVisible(true)
	end)

	do -- pencere surukleme
		local drag, startIn, startPos
		top.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				drag, startIn, startPos = true, i.Position, holder.Position
			end
		end)
		keep(UIS.InputChanged:Connect(function(i)
			if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				local d = i.Position - startIn
				holder.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end))
		keep(UIS.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end
		end))
	end

	minB.MouseButton1Click:Connect(function() setVisible(false) end)
	function Win:Destroy()
		for _, c in ipairs(conns) do c:Disconnect() end
		tw(blur, 0.25, { Size = 0 })
		task.delay(0.3, function() blur:Destroy() end)
		gui:Destroy()
	end
	closeB.MouseButton1Click:Connect(function() Win:Destroy() end)

	Win.ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
	keep(UIS.InputBegan:Connect(function(i, gp)
		if not gp and i.KeyCode == Win.ToggleKey then setVisible(not visible) end
	end))
	keep(camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		if visible then tw(scale, 0.2, { Scale = baseScale() }) end
	end))

	function Win:SetAccent(c)
		Nova.Accent = c
		for _, a in ipairs(accentSet) do
			if a[1].Parent then tw(a[1], 0.3, { [a[2]] = c }) end
		end
		for _, fn in ipairs(accentGrads) do fn() end
	end
	function Win:SetScale(s) customScale = s if visible then tw(scale, 0.2, { Scale = s }) end end

	------------------------------------------------ acilis animasyonu
	do
		local splash = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(290, 150), BackgroundColor3 = theme.bg0, BorderSizePixel = 0, Parent = gui }, { corner(20), stroke(Nova.Accent, 1.5, 0.2) })
		local ss = mk("UIScale", { Scale = 0.6, Parent = splash })
		local sl = mk("Frame", { Size = UDim2.fromOffset(50, 50), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 20), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = splash }, { corner(16) })
		accentGradient(sl, 45)
		txt({ Text = string.upper(string.sub(cfg.Title or "N", 1, 1)), Font = Enum.Font.GothamBlack, TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = sl })
		txt({ Text = string.upper(cfg.Title or "Nova"), Font = Enum.Font.GothamBlack, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 80), Parent = splash })
		local st = txt({ Text = "Loading...", TextSize = 11, TextColor3 = theme.dim, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 102), Parent = splash })
		local tr = mk("Frame", { Size = UDim2.new(1, -56, 0, 5), Position = UDim2.fromOffset(28, 128), BackgroundColor3 = theme.bg1, BorderSizePixel = 0, Parent = splash }, { corner(3) })
		local fl = mk("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = tr }, { corner(3) })
		accentGradient(fl, 0)
		tw(ss, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
		task.spawn(function()
			for _, s in ipairs({ { "Loading modules...", 0.35 }, { "Applying theme...", 0.72 }, { "Ready", 1 } }) do
				st.Text = s[1]
				tw(fl, 0.4, { Size = UDim2.fromScale(s[2], 1) })
				task.wait(0.42)
			end
			tw(ss, 0.3, { Scale = 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tw(splash, 0.3, { BackgroundTransparency = 1 })
			for _, d in ipairs(splash:GetDescendants()) do
				if d:IsA("TextLabel") then tw(d, 0.25, { TextTransparency = 1 }) elseif d:IsA("Frame") then tw(d, 0.25, { BackgroundTransparency = 1 }) end
			end
			task.wait(0.32)
			splash:Destroy()
			setVisible(true)
			if cfg.OnReady then task.spawn(cfg.OnReady) end
		end)
	end

	return Win
end

