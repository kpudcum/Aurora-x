		accentGrad(tl, 0)
		local sl = lbl({ Text = steps[1], TextSize = 11, TextColor3 = T.sub, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 150) }, sCard)
