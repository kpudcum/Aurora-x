local function shift(c)
	local h, s, v = c:ToHSV()
	return Color3.fromHSV((h + 0.1) % 1, s, v)
end

local accent = PRESETS.Violet
local accent2 = shift(accent)
local hooks, themed, themeHooks, statHooks = {}, {}, {}, {}
local rainbow = false

local function onAccent(fn)
	table.insert(hooks, fn)
	fn(accent, accent2)
end

function Omega:SetAccent(a, b)
	if type(a) == "string" then a = PRESETS[a] end
	if typeof(a) ~= "Color3" then return end
	accent, accent2 = a, b or shift(a)
	for _, fn in ipairs(hooks) do fn(accent, accent2) end
end

-- tema kaydi: nesne.ozellik her tema degisiminde T[key] ile guncellenir
local function th(o, prop, key)
	table.insert(themed, { o = o, p = prop, k = key })
	return o
end
local function bg(f, key) return th(f, "BackgroundColor3", key) end

function Omega:SetTheme(name)
	local t = THEMES[name]
	if not t then return end
	for k, v in pairs(t) do T[k] = v end
	local alive = {}
	for _, e in ipairs(themed) do
		if e.o.Parent then
			e.o[e.p] = T[e.k]
			table.insert(alive, e)
		end
	end
	themed = alive
	for _, fn in ipairs(hooks) do fn(accent, accent2) end
	for _, fn in ipairs(themeHooks) do pcall(fn) end
end

