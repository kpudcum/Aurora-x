				fill.Parent = track
				local ks = IS_MOBILE and 20 or 14
				local knob = new("Frame", { Size = UDim2.fromOffset(ks, ks), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3 }, { corner(ks / 2), stroke(accent, 2, 0) })
