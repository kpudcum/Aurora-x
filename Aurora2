							Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = T.sub, AutoButtonColor = false, ZIndex = 7,
						}, { corner(9) })
						bg(b, "bg1")
						th(b, "TextColor3", "sub")
						b.Activated:Connect(function()
							tw(b, 0.08, { TextColor3 = accent })
							task.delay(0.12, function() tw(b, 0.15, { TextColor3 = T.sub }) end)
							setVal((val or min) + inc * dir)
						end)
						b.Parent = r
					end
					stepBtn("−", UDim2.new(0, 8, 1, -34), -1)
					stepBtn("+", UDim2.new(1, -38, 1, -34), 1)
				end
				function obj:Set(v) setVal(v, false, false) end
				function obj:Get() return val end
				setVal(math.clamp(o.Default or min, min, max), true, true)
				reg(o, val, function(v) obj:Set(v) end)
				return obj
			end

			-- tek / coklu secimli acilir liste ortak kodu
			local function makeDropdown(o, multi)
				local opts2 = o.Options or {}
				local cur = o.Default
				local sel = {}
				if multi then
					for _, n in ipairs(o.Default or {}) do sel[n] = true end
				else
					cur = o.Default or opts2[1]
				end
				local open = false
				local IH = IS_MOBILE and 34 or 28
				local r = row(RH, o.Name)
				lbl({ Text = o.Name, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0.45, -14, 0, RH) }, r)
				local vl = lbl({ Text = "", TextSize = 12, TextColor3 = T.sub, TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.55, -40, 0, RH), Position = UDim2.new(0.45, 0, 0, 0) }, r)
				local arrow = lbl({ Text = "›", Font = Enum.Font.GothamBold, TextSize = 20, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(28, RH), Position = UDim2.new(1, -32, 0, 0), Rotation = 90 }, r)
				local lst = new("Frame", { Position = UDim2.fromOffset(8, RH + 6), Size = UDim2.new(1, -16, 0, 0), BackgroundTransparency = 1 }, { vlist(4) })
				lst.Parent = r
				local head2 = new("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, RH), BackgroundTransparency = 1, ZIndex = 5 })
				head2.Parent = r
				local obj = {}
				local function height() return open and (RH + 10 + #opts2 * (IH + 4)) or RH end
				local function valueOut()
					if multi then
						local t = {}
						for _, n in ipairs(opts2) do if sel[n] then table.insert(t, n) end end
						return t
					end
					return cur
				end
				local function showText()
					if multi then
						local t = valueOut()
						vl.Text = #t == 0 and "None" or (#t <= 2 and table.concat(t, ", ") or (#t .. " selected"))
					else
						vl.Text = tostring(cur or "-")
					end
				end
				local function build()
					for _, c in ipairs(lst:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
					for idx, name in ipairs(opts2) do
						local on = multi and sel[name] or (not multi and name == cur)
						local b = new("TextButton", {
							Text = (multi and (sel[name] and "✓  " or "    ") or "") .. tostring(name), Size = UDim2.new(1, 0, 0, IH), BackgroundColor3 = T.bg1, BackgroundTransparency = 0.3, BorderSizePixel = 0,
							Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = on and accent or T.sub, AutoButtonColor = false, LayoutOrder = idx,
						}, { corner(8) })
						bg(b, "bg1")
						b.MouseEnter:Connect(function() tw(b, 0.12, { BackgroundTransparency = 0 }) end)
						b.MouseLeave:Connect(function() tw(b, 0.12, { BackgroundTransparency = 0.3 }) end)
						b.Activated:Connect(function()
							if multi then
								sel[name] = not sel[name] or nil
								obj:Changed()
							else
								obj:Set(name)
								obj:Toggle(false)
							end
						end)
						b.Parent = lst
					end
				end
				function obj:Changed(silent)
					showText()
					build()
					setFlag(o, valueOut())
					if not silent then fire(o.Callback, valueOut()) end
				end
				function obj:Toggle(v)
					if v == nil then open = not open else open = v end
					tw(r, 0.3, { Size = UDim2.new(1, 0, 0, height()) })
					tw(arrow, 0.3, { Rotation = open and -90 or 90 }, Enum.EasingStyle.Back)
				end
				function obj:Set(v, silent)
					if multi then
						sel = {}
						for _, n in ipairs(v or {}) do sel[n] = true end
					else
						cur = v
					end
					obj:Changed(silent)
				end
				function obj:SetOptions(list2)
					opts2 = list2
					build()
					if open then r.Size = UDim2.new(1, 0, 0, height()) end
				end
				function obj:Get() return valueOut() end
				head2.MouseButton1Click:Connect(function() obj:Toggle() end)
				table.insert(themeHooks, build)
				showText()
				build()
				reg(o, valueOut(), function(v) obj:Set(v) end)
				return obj
			end
