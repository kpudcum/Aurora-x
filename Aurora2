			tw(sScale, 0.35, { Scale = baseScale * 1.15 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tw(sCard, 0.35, { GroupTransparency = 1 })
			task.wait(0.38)
			local ix = table.find(ticks, spin)
			if ix then table.remove(ticks, ix) end
			sCard:Destroy()
			Win:Open()
			Omega:Notify({ Title = "Aurora Omega", Content = IS_MOBILE and "UI loaded. Tap — to minimize." or ("UI loaded. Toggle key: " .. Win.ToggleKey.Name), Type = "success" })
		end)
	end

	if getgenv then pcall(function() getgenv().OmegaUI = Omega end) end
	Omega.Window = Win
	return Win
end

