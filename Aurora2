			function Sec:AddColorPicker(o)
				local col = o.Default or accent
				local h, s, v = col:ToHSV()
				local open = false
				local SVH = IS_MOBILE and 120 or 100
				local HW = IS_MOBILE and 28 or 22
				local r = row(RH, o.Name)
				lbl({ Text = o.Name, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -70, 0, RH) }, r)
				local sw = new("Frame", { Size = UDim2.fromOffset(36, 22), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, RH / 2), BackgroundColor3 = col, BorderSizePixel = 0 }, { corner(6), stroke(WHITE, 1, 0.6) })
				sw.Parent = r
				local head3 = new("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, RH), BackgroundTransparency = 1, ZIndex = 5 })
				head3.Parent = r

				local svBox = new("Frame", { Position = UDim2.fromOffset(12, RH + 8), Size = UDim2.new(1, -(HW + 34), 0, SVH), BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0 }, { corner(8) })
				local wh = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, { corner(8) })
				new("UIGradient", { Transparency = NumberSequence.new(0, 1) }).Parent = wh
				wh.Parent = svBox
				local bk = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, { corner(8) })
				new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }).Parent = bk
				bk.Parent = svBox
				local svCur = new("Frame", { Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 4 }, { corner(7), stroke(WHITE, 2, 0) })
				svCur.Parent = svBox
				svBox.Parent = r

				local hueBar = new("Frame", { Position = UDim2.new(1, -(HW + 14), 0, RH + 8), Size = UDim2.fromOffset(HW, SVH), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, { corner(8) })
				local keys = {}
				for i = 0, 6 do table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i == 6 and 0.999 or i / 6, 1, 1))) end
				new("UIGradient", { Rotation = 90, Color = ColorSequence.new(keys) }).Parent = hueBar
				local hCur = new("Frame", { Size = UDim2.new(1, 6, 0, 4), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 4 }, { corner(2), stroke(Color3.new(0, 0, 0), 1, 0.5) })
				hCur.Parent = hueBar
				hueBar.Parent = r

				local obj = {}
				local function refresh(silent)
					col = Color3.fromHSV(h, s, v)
					sw.BackgroundColor3 = col
					svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
					svCur.Position = UDim2.fromScale(s, 1 - v)
					hCur.Position = UDim2.fromScale(0.5, h)
					setFlag(o, col)
					if not silent then fire(o.Callback, col) end
				end
				dragRegion(svBox, page, function(rx, ry) s, v = rx, 1 - ry refresh() end)
				dragRegion(hueBar, page, function(_, ry) h = math.min(ry, 0.999) refresh() end)
				head3.MouseButton1Click:Connect(function()
					open = not open
					tw(r, 0.3, { Size = UDim2.new(1, 0, 0, open and (RH + 16 + SVH) or RH) })
				end)
				function obj:Set(c) if typeof(c) == "Color3" then h, s, v = c:ToHSV() refresh() end end
				function obj:Get() return col end
				refresh(true)
				reg(o, col, function(c) obj:Set(c) end)
				return obj
			end

			return Sec
		end

		return Tab
	end

	------------------------------------------------ HAZIR AYARLAR SEKMESI
	function Win:BuildSettings()
		local tab = Win:AddTab("Settings", "⚙")
		local ap = tab:AddSection("Appearance")
		ap:AddDropdown({ Name = "Theme", Options = THEME_NAMES, Default = "Midnight", Flag = "_theme", Callback = function(n) Omega:SetTheme(n) end })
		ap:AddDropdown({ Name = "Accent color", Options = PRESET_NAMES, Default = "Violet", Flag = "_accent", Callback = function(n)
			rainbow = false
			Omega:SetAccent(n)
		end })
		ap:AddToggle({ Name = "Rainbow accent", Flag = "_rainbow", Callback = function(on)
			rainbow = on
			if not on then Omega:SetAccent(PRESETS[Omega.Flags._accent or "Violet"]) end
		end })
		ap:AddSlider({ Name = "Menu scale", Min = 0.6, Max = 1.3, Default = 1, Increment = 0.05, Flag = "_scale", Callback = function(v) Win:SetScaleMul(v) end })
		ap:AddToggle({ Name = "Background blur", Default = blurEnabled, Flag = "_blur", Callback = function(on) Win:SetBlur(on) end })
		ap:AddToggle({ Name = "FPS / Ping HUD", Flag = "_hud", Callback = function(on) Win:SetHud(on) end })
		if not IS_MOBILE then
			ap:AddKeybind({ Name = "Menu key", Default = Win.ToggleKey, Flag = "_menukey", Changed = function(k) Win.ToggleKey = k end })
		else
			ap:AddParagraph("Mobile tips", "Tap — to minimize into the round button. Drag the round button or the top bar to move them. Use the − / + buttons on sliders for precise values.")
		end

		local cf = tab:AddSection("Config")
		local nameBox = cf:AddTextBox({ Name = "Config name", Default = "default", Placeholder = "name" })
		local canFile = type(writefile) == "function" and type(readfile) == "function"
		local function path() return "AuroraOmega_" .. (nameBox:Get() ~= "" and nameBox:Get() or "default") .. ".json" end
		cf:AddButton({ Name = "Save config", Callback = function()
			if not canFile then return Omega:Notify({ Title = "Config", Content = "Executor has no file API.", Type = "error" }) end
			local data = {}
			for k, val in pairs(Omega.Flags) do
				if typeof(val) == "Color3" then data[k] = { __c = { val.R, val.G, val.B } } else data[k] = val end
			end
			local ok = pcall(function() writefile(path(), HttpService:JSONEncode(data)) end)
			Omega:Notify({ Title = "Config", Content = ok and ("Saved: " .. nameBox:Get()) or "Save failed", Type = ok and "success" or "error" })
		end })
		cf:AddButton({ Name = "Load config", Callback = function()
			if not canFile then return Omega:Notify({ Title = "Config", Content = "Executor has no file API.", Type = "error" }) end
			local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path())) end)
			if not ok or type(data) ~= "table" then
				return Omega:Notify({ Title = "Config", Content = "Config not found", Type = "warn" })
			end
			for k, val in pairs(data) do
				if type(val) == "table" and val.__c then val = Color3.new(val.__c[1], val.__c[2], val.__c[3]) end
				if Omega._setters[k] then pcall(Omega._setters[k], val) end
			end
			Omega:Notify({ Title = "Config", Content = "Loaded: " .. nameBox:Get(), Type = "success" })
		end })

		local mi = tab:AddSection("Menu")
		mi:AddButton({ Name = "Unload UI", Callback = function() Win:Close(false) task.delay(0.35, function() Omega:Unload() end) end })
		return tab
	end

