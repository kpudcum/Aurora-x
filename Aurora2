	local tabCount = 0
	local function paintTabs()
		for _, t in ipairs(Win.Tabs) do
			local on = t == Win.Current
			if t.text then t.text.TextColor3 = on and T.text or T.sub end
			if t.iconLabel then t.iconLabel.TextColor3 = on and accent or T.dim end
			if t.iconImage then t.iconImage.ImageColor3 = on and accent or T.dim end
		end
	end
	local function selectTab(tab)
		if Win.Current == tab then return end
		Win.Current = tab
		for _, t in ipairs(Win.Tabs) do
			local on = t == tab
			if t.text then tw(t.text, 0.25, { TextColor3 = on and T.text or T.sub }) end
			if t.iconLabel then tw(t.iconLabel, 0.25, { TextColor3 = on and accent or T.dim }) end
			if t.iconImage then tw(t.iconImage, 0.25, { ImageColor3 = on and accent or T.dim }) end
			if not on then t.page.Visible = false end
		end
		indicator.Visible = true
		tw(indicator, 0.4, { Position = UDim2.fromOffset(0, tab.y) }, Enum.EasingStyle.Back)
		tab.page.Position = UDim2.fromOffset(22, 0)
		tab.page.Visible = true
		tw(tab.page, 0.4, { Position = UDim2.fromOffset(0, 0) })
	end
