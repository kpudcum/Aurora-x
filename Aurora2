local notifN = 0
function Omega:Notify(o)
	o = o or {}
	notifN += 1
	local col = ({ success = T.ok, warn = T.warn, error = T.err })[o.Type]
	local glyph = ({ success = "✓", warn = "!", error = "✕" })[o.Type] or "i"
	local dur = o.Duration or 4
	local outPos = COMPACT and UDim2.new(0, 0, -1.8, 0) or UDim2.new(1.3, 0, 0, 0)

	local slot = new("Frame", { Size = UDim2.new(1, 0, 0, 72), BackgroundTransparency = 1, LayoutOrder = COMPACT and -notifN or notifN })
	local card = new("CanvasGroup", { Size = UDim2.fromScale(1, 1), Position = outPos, BackgroundColor3 = T.card, BorderSizePixel = 0 }, { corner(14) })
	bg(card, "card")
	local edge = stroke(col or accent, 1.4, 0.2)
	edge.Parent = card
	if not col then onAccent(function(a) edge.Color = a end) end

	local ic = new("Frame", { Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(12, 14), BackgroundColor3 = col or WHITE, BorderSizePixel = 0 }, { corner(10) })
	if not col then accentGrad(ic, 45) end
	ic.Parent = card
	lbl({ Text = glyph, Font = Enum.Font.GothamBlack, TextSize = 16, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1) }, ic)
	lbl({ Text = tostring(o.Title or "Aurora"), Font = Enum.Font.GothamBold, TextSize = 13, Size = UDim2.new(1, -62, 0, 16), Position = UDim2.fromOffset(56, 10) }, card)
	lbl({
		Text = tostring(o.Content or ""), TextSize = 12, TextColor3 = T.sub, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
		TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -66, 0, 30), Position = UDim2.fromOffset(56, 28),
	}, card)
	local bar = new("Frame", { Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3), BackgroundColor3 = col or WHITE, BorderSizePixel = 0 })
	if not col then accentGrad(bar, 0) end
	bar.Parent = card
	card.Parent = slot
	slot.Parent = notifHolder

	tw(card, 0.5, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
	tw(bar, dur, { Size = UDim2.new(0, 0, 0, 3) }, Enum.EasingStyle.Linear)
	task.delay(dur, function()
		if not card.Parent then return end
		tw(card, 0.35, { Position = outPos, GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.4)
		slot:Destroy()
	end)
end

