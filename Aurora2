				else
					hit.Size = UDim2.new(1, 0, 0, 26)
					hit.Position = UDim2.new(0, 0, 1, -30)
				end
				hit.Parent = r
				local obj = {}
				local function setVal(v, silent, instant)
					v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
					v = tonumber(string.format("%.4f", v))
					local changed = v ~= val
					val = v
					local rr = (max - min) == 0 and 0 or (v - min) / (max - min)
					local t = instant and 0 or 0.1
					tw(fill, t, { Size = UDim2.fromScale(rr, 1) })
					tw(knob, t, { Position = UDim2.new(rr, 0, 0.5, 0) })
					vl.Text = tostring(v) .. (o.Suffix or "")
					setFlag(o, v)
					if changed and not silent then fire(o.Callback, v) end
				end
				dragRegion(hit, page, function(rx) setVal(min + (max - min) * rx) end)
