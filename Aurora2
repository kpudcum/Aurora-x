local conns, ticks = {}, {}
local function bind(sig, fn)
	local c = sig:Connect(fn)
	conns[#conns + 1] = c
	return c
end

local function new(class, props, kids)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	for _, c in ipairs(kids or {}) do c.Parent = o end
	return o
end

local function tw(o, t, p, style, dir)
	local x = TS:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), p)
	x:Play()
	return x
end

local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function stroke(c, t, tr)
	local st = new("UIStroke", { Color = c or T.line, Thickness = t or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
	if c == nil or c == T.line then th(st, "Color", "line") end
	return st
end
local function pad(l, t, r, b)
	return new("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b) })
end
local function vlist(gap)
	return new("UIListLayout", { Padding = UDim.new(0, gap or 8), SortOrder = Enum.SortOrder.LayoutOrder })
end

local function lbl(p, parent)
	p.BackgroundTransparency = 1
	p.Font = p.Font or Enum.Font.GothamMedium
	p.TextColor3 = p.TextColor3 or T.text
	p.TextSize = p.TextSize or 13
	p.TextXAlignment = p.TextXAlignment or Enum.TextXAlignment.Left
	local role = (p.TextColor3 == T.text and "text") or (p.TextColor3 == T.sub and "sub") or (p.TextColor3 == T.dim and "dim") or nil
	local l = new("TextLabel", p)
	if role then th(l, "TextColor3", role) end
	if parent then l.Parent = parent end
	return l
end

local function accentGrad(parent, rot)
	local g = new("UIGradient", { Rotation = rot or 0 })
	onAccent(function(a, b) g.Color = ColorSequence.new(a, b) end)
	g.Parent = parent
	return g
end

local function fire(cb, ...)
	if not cb then return end
	local ok, e = pcall(cb, ...)
	if not ok then warn("[Omega] callback hatasi: " .. tostring(e)) end
end

local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function isMove(i) return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end

-- IgnoreGuiInset acik oldugu icin Y konumu inset ile duzeltilir
local function ypos(i)
	if i.UserInputType == Enum.UserInputType.Touch then
		return i.Position.Y + GuiService:GetGuiInset().Y
	end
	return UIS:GetMouseLocation().Y
end

-- bir alan icinde surukleme (slider, renk secici); fn(rx, ry) 0..1
local function dragRegion(hit, page, fn, fin)
	local d = false
	local function rel(i)
		return math.clamp((i.Position.X - hit.AbsolutePosition.X) / math.max(1, hit.AbsoluteSize.X), 0, 1),
			math.clamp((ypos(i) - hit.AbsolutePosition.Y) / math.max(1, hit.AbsoluteSize.Y), 0, 1)
	end
	bind(hit.InputBegan, function(i)
		if isPress(i) then
			d = true
			if page then page.ScrollingEnabled = false end
			fn(rel(i))
		end
	end)
	bind(UIS.InputChanged, function(i)
		if d and isMove(i) then fn(rel(i)) end
	end)
	bind(UIS.InputEnded, function(i)
		if d and isPress(i) then
			d = false
			if page then page.ScrollingEnabled = true end
			if fin then fin() end
		end
	end)
end

-- surukleme; "suruklendi mi" fonksiyonu dondurur
local function makeDraggable(handle, target, clampToScreen)
	local drag, startIn, startPos, moved = false, nil, nil, false
	bind(handle.InputBegan, function(i)
		if isPress(i) then
			drag, moved, startIn, startPos = true, false, i.Position, target.Position
			local c
			c = i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					drag = false
					c:Disconnect()
				end
			end)
		end
	end)
	bind(UIS.InputChanged, function(i)
		if drag and isMove(i) then
			local d = i.Position - startIn
			if d.Magnitude > 6 then moved = true end
			if moved then
				local nx, ny = startPos.X.Offset + d.X, startPos.Y.Offset + d.Y
				target.Position = UDim2.new(startPos.X.Scale, nx, startPos.Y.Scale, ny)
			end
		end
	end)
	return function() return moved end
end

