				tl.Text = string.sub(full, 1, i)
				task.wait(0.045)
			end
			for i, step in ipairs(steps) do
				sl.Text = step
				tw(pf, 0.45, { Size = UDim2.fromScale(i / #steps, 1) }, Enum.EasingStyle.Quad)
