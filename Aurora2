	function Win:Open()
		if Win.IsOpen then return end
		Win.IsOpen = true
		launcher.Visible = false
		holder.Visible = true
		uiscale.Scale = fit() * Win.ScaleMul * 0.72
		tw(uiscale, 0.55, { Scale = fit() * Win.ScaleMul }, Enum.EasingStyle.Back)
		tw(main, 0.4, { GroupTransparency = 0 })
		if blurEnabled then tw(blur, 0.5, { Size = 14 }) end
		shine.Position = UDim2.new(-0.3, 0, -0.4, 0)
		shine.Visible = true
		tw(shine, 1.1, { Position = UDim2.new(1.3, 0, -0.4, 0) }, Enum.EasingStyle.Quad).Completed:Connect(function() shine.Visible = false end)
	end
	function Win:Close(toLauncher)
		if not Win.IsOpen then return end
		Win.IsOpen = false
		tw(uiscale, 0.28, { Scale = uiscale.Scale * 0.75 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tw(main, 0.25, { GroupTransparency = 1 })
		tw(blur, 0.3, { Size = 0 })
		task.delay(0.3, function()
			if not Win.IsOpen then
				holder.Visible = false
				if toLauncher then
					launcher.Visible = true
					lScale.Scale = 0.01
					tw(lScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
				end
			end
		end)
	end
	function Win:Toggle()
		if Win.IsOpen then Win:Close(true) else Win:Open() end
	end
	function Win:SetBlur(on)
		blurEnabled = on
		tw(blur, 0.3, { Size = (on and Win.IsOpen) and 14 or 0 })
	end

