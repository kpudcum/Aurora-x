	local function applyScale(animate)
		local target = fit() * Win.ScaleMul
		if animate then tw(uiscale, 0.25, { Scale = target }, Enum.EasingStyle.Quad) else uiscale.Scale = target end
	end
	function Win:SetScaleMul(m)
		Win.ScaleMul = math.clamp(m, 0.5, 1.4)
		if Win.IsOpen then applyScale(true) end
	end
	local function hookCamera()
		local cam = workspace.CurrentCamera
		if cam then
			bind(cam:GetPropertyChangedSignal("ViewportSize"), function() if Win.IsOpen then applyScale(true) end end)
		end
	end
	hookCamera()
	bind(workspace:GetPropertyChangedSignal("CurrentCamera"), function() hookCamera() end)

